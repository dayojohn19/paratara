  :root {
    /* Main Palette Inspired by Uploaded Theme */
    --surface: #fdfbf5;
    --surface-alt: #f4f0e4;
    --page-bg: #eef1e4;

    --accent: #556b2f;
    --accent-dark: #38461f;
    --accent-light: #8c6b4f;

    --text: #3f3a2f;
    --text-muted: #7a7468;

    --border: #d8d2c3;

    --shadow-sm: none;
    --shadow-md: none;
    --radius-lg: 0px;
    --radius-md: 0px;
    --radius-sm: 0px;
    --transition: 0s linear;
    --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Oxygen", "Ubuntu", "Helvetica Neue", Arial, sans-serif;
    --font-size-base: 16px;
    --line-height-base: 1.58;
  }


  body {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: var(--line-height-base);
    color: var(--text);
    min-height: 100vh;
    margin: 0;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  input,
  select,
  textarea,
  button {
    font: inherit;
    line-height: 1.35;
  }



  .hero {
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
    
  }

  /* .hero__info {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: 1 1 280px;
    min-width: 0;
  } */

  .hero__icon {
    width: 60px;
    height: 60px;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hero__icon svg {
    width: 28px;
    height: 28px;
    fill: #ffffff;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hero__heading {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 750;
    color: var(--accent);
    line-height: 1.12;
  }

  .hero__subtitle {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .ask-box {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .ask-input {
    width: 100vw;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    font-size: 1rem;
    max-width: 700px;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .ask-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .ask-send-btn {
    padding: 0.6rem;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--accent);
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition), box-shadow var(--transition);
  }



  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.7rem 1.3rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    font-weight: 650;
    font-size: 0.98rem;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: transform var(--transition), box-shadow var(--transition), background var(--transition), color var(--transition), border-color var(--transition);
  }

  .button svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .button--primary {
    background: var(--accent);
    color: #ffffff;
  }



  .button--ghost {
    
    border-color: var(--border);
    color: var(--accent);
  }

  .primary-grid {
    display: grid;
    gap: 24px;
    margin-top: 16px;
  }

  @media (min-width: 992px) {
    .primary-grid {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    }
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 1em;
  }

  .panel__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

.page-stack {
  display: flex;
  flex-direction: column;
  gap: 28px;
  margin-top: 28px;
}

.page-stack > section,
#blogs {
  content-visibility: auto;
  contain-intrinsic-size: auto 700px;
}

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-header h2 {
    font-size: clamp(1.45rem, 3vw, 1.9rem);
    font-weight: 700;
    line-height: 1.25;
    color: rgba(167, 163, 100, 0.84);
  }

  .section-header p {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  #calendar-container {
    overflow: hidden;
  }

  #calendar-container table {
    width: 100%;
    border-collapse: collapse;
    
  }

  #calendar-container th,
  #calendar-container td {
    padding: 14px;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.35;
  }

  #calendar-container th {
    background: #eef2ff;
    color: var(--accent);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    font-weight: 700;
  }

  #calendar-container td {
    border: 1px solid var(--border);
    font-weight: 500;
    color: #4a5568;
    cursor: pointer;
    transition: background var(--transition), color var(--transition), transform var(--transition);
  }

  .calendar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 18px 20px;
    background: var(--surface-alt);
    border-bottom: 1px solid var(--border);
  }

  .calendar-header h2 {
    font-size: 1.35rem;
    color: var(--text);
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .nav-buttons {
    display: flex;
    gap: 10px;
  }

  .calendar-header-left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .nav-buttons a {
    text-decoration: none;
  }

  .nav-btn {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    border: none;
    background: #eef2ff;
    color: var(--accent);
    font-size: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background var(--transition), color var(--transition), transform var(--transition);
  }

  .add-schedule-btn {
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--accent);
    background: #ffffff;
    color: var(--accent);
    font-weight: 700;
    cursor: pointer;
    transition: background var(--transition), color var(--transition), box-shadow var(--transition), transform var(--transition);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 6px;
    background: var(--accent);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 600;
    transition: transform var(--transition), background var(--transition);
    position: absolute;
    top: 6px;
    cursor: pointer;
  }

  td.has-badge {
    position: relative;
  }

  .chat-container {
    display: flex;
    flex-direction: column;
    gap: 18px;
    height: 100%;
  }

  .chat-messages {
    flex: 1;
    min-height: 320px;
    max-height: 560px;
    overflow-y: auto;
    padding: 5px;
    flex-direction: column-reverse;
    gap: 14px;

  }

  .chat-messages::-webkit-scrollbar {
    width: 6px;
  }

  .chat-messages::-webkit-scrollbar-track {
    background: #edf2f7;
  }

  .chat-messages::-webkit-scrollbar-thumb {
    background: #cbd5e0;
  }

  .message-bubble {
    background: #ffffff;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    font-size: 1rem;
    line-height: 1.65;
    word-break: break-word;
  }

  .message-bubble span {
    font-weight: 700;
    color: var(--accent);
    margin-right: 6px;
  }

  .message-time {
    margin-top: 8px;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .chat-input-area {
    display: flex;
    gap: 12px;
    align-items: flex-end;
    padding: 15px;
  }

  .chat-input {
    flex: 1;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    border: 2px solid var(--border);
    font-size: 1rem;
    resize: none;
    min-height: 56px;
    transition: border-color var(--transition), box-shadow var(--transition);
    font-family: inherit;
  }

  .chat-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .chat-send-btn {
    width: 54px;
    height: 54px;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: transform var(--transition), box-shadow var(--transition), opacity var(--transition);
  }

  .chat-send-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .chat-send-btn svg {
    width: 20px;
    height: 20px;
    fill: #ffffff;
  }

  .chat-send-btn .spinner {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255, 255, 255, 0.6);
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .calendar-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .calendar-event-card {
    position: relative;
    min-height: 220px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-size: cover;
    background-position: center;
    transition: transform var(--transition), box-shadow var(--transition);
    cursor: pointer;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(14, 23, 53, 0.58);
  }

  .card-content {
    position: absolute;
    inset: auto 0 0 0;
    padding: 20px;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 1;
  }

  .card-content h4 {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .card-content p {
    font-size: 0.95rem;
    line-height: 1.45;
    opacity: 0.9;
  }

  .calendar-list {
    display: flex;
    align-items: center;
    border-top: 1px solid #e9ecef;
    gap: 1rem;
    flex-wrap: wrap;
    overflow: scroll;
  }

  .calendar-list > * {
    flex-shrink: 0;
    min-width: max-content;
  }

  .loading-symbol {
    width: 54px;
    height: 54px;
    border: 4px solid rgba(103, 120, 219, 0.25);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 32px auto;
  }

  .blog-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

.blog-category {
  display: inline-block;
  padding: 5px 12px;

  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: uppercase;

  color: #fff;
  line-height: 1.2;
  white-space: nowrap;
}

/* Category Colors */
.category-guide {
  background: #bd7b1c;
}

.category-story {
  background: #7f3aed;
}

.category-tip-and-trick {
  background: #499605;
}

.category-explore {
  background: #ea0ce3;
}

.category-product {
  background: #dc2626;
}
  .blog-title {
    font-size: 1.22rem;
    color: var(--text);
    margin-bottom: 12px;
    font-weight: 650;
    line-height: 1.35;
  }

  .blog-excerpt {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.65;
    margin-bottom: 18px;
  }

  .blog-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .blog-meta-left {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .blog-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .blog-card {
    color: var(--accent);
    font-weight: 650;
    text-decoration: none;
    font-size: 0.98rem;
    transition: color var(--transition);
  }


  .empty-state {
    text-align: center;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-muted);
    padding: 24px;
    background: var(--surface-alt);
    border-radius: var(--radius-md);
    border: 1px dashed #cbd5f5;
  }

  /* Pagination Styles */
  .pagination-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .pagination-btn {
    padding: 8px 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--accent);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all var(--transition);
    min-width: 40px;
    text-align: center;
  }

  .pagination-btn.active {
    background: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
    font-weight: 600;
  }

  .pagination-dots {
    padding: 8px 4px;
    color: var(--text-muted);
    font-size: 0.9rem;
    user-select: none;
  }

  .load-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 16px;
  }

  .load-more-wrap[hidden] {
    display: none;
  }

  .place-load-more-btn:disabled {
    opacity: 0.65;
    cursor: default;
  }

  @media (max-width: 480px) {
    .pagination-controls {
      gap: 4px;
    }

    .pagination-btn {
      padding: 6px 8px;
      font-size: 0.8rem;
      min-width: 32px;
    }
  }

  #mapModal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(13, 27, 62, 0.45);
    align-items: center;
    justify-content: center;
    z-index: 1500;
  }

  #mapModal.show {
    display: flex;
  }

  #mapModal > div {
    /* width: min(95vw, 100%);
    height: min(95vh, 860px); */
    width: 100%;
    height: 100%;
    
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
    box-shadow: var(--shadow-md);
  }

  #closeMapBtn {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.9);
    font-size: 26px;
    cursor: pointer;
    color: var(--text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition), transform var(--transition);
    z-index: 2;
  }

  .modal {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(13, 27, 62, 0.65);
    z-index: 2000;
    padding-top: 24px;
    overflow-y: auto;
  }

  .modal-content {
    
    border-radius: var(--radius-lg);
    max-width: 700px;
    overflow: hidden;
    box-shadow: none;
    margin: 0 auto;
  }

  .modal-header {
    background: var(--accent);
    color: #ffffff;
    padding: 13px 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.25;
    font-weight: 700;
  }

  .close {
    font-size: 32px;
    font-weight: 400;
    cursor: pointer;
    transition: transform var(--transition), opacity var(--transition);
    line-height: 1.1;
  }

  .modal-body {
    padding: 0;
    color: var(--text);
    line-height: 1.65;
    background-color: white;
  }

  .modal-image img {
    width: 100%;
    display: block;
  }

  .modal-footer {
    padding: 20px 24px;
    background: var(--surface-alt);
  }

  /* Add Schedule modal form styling */
  #addScheduleModal .modal-content {
    max-width: 720px;
  }

  #addScheduleForm {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .add-schedule-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }

  #addScheduleForm label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-weight: 600;
    color: var(--text);
  }

  #addScheduleForm input,
  #addScheduleForm select {
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 1rem;
    
    transition: border var(--transition), box-shadow var(--transition);
  }

  #addScheduleForm input:focus,
  #addScheduleForm select:focus {
    outline: none;
    border-color: var(--accent);
  }

  #addScheduleStatus {
    min-height: 20px;
    font-weight: 600;
    color: var(--accent);
  }

  .add-schedule-actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    margin-top: 6px;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 680px) {
    .hero {
      padding: 22px;
    }
/* 
    .hero__info {
      flex-direction: row;
      align-items: center;
    } */

    .hero__icon {
      width: 52px;
      height: 52px;
    }

    .hero__actions {
      width: 100%;
      justify-content: flex-start;
    }

    .ask-box {
      width: 100%;
      margin-bottom: 12px;
    }

    .ask-input {
      width: 100%;
      min-width: auto;
    }

    .chat-messages {
      max-height: 480px;
    }

    .chat-input-area {
      flex-direction: column;
      align-items: stretch;
    }

    .chat-send-btn {
      width: 100%;
      height: 48px;
    }

    .calendar-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .nav-buttons {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (max-width: 480px) {


    .panel {
      padding: 20px;
    }

    #calendar-container th,
    #calendar-container td {
      padding: 10px 8px;
      font-size: 0.8rem;
    }

    .calendar-event-card {
      min-height: 200px;
    }

    .card-content h4 {
      font-size: 1.05rem;
    }

    .chat-messages {
      padding: 16px;
    }

    .chat-input {
      font-size: 0.9rem;
    }

    #allDiscussion {
      max-height: 35vh !important;
    }

    #mobileChatModal .modal-content {
      max-height: 90vh;
    }
  }

  #mobileChatBtn {
    position: fixed;
    right: 20px;
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    width: 56px;
    height: 56px;
    border-radius: 0;
    border: 0;
    background: var(--accent);
    box-shadow: none;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: none;
  }

  #mobileChatBtn svg {
    width: 24px;
    height: 24px;
    fill: #ffffff;
  }

  #mobileChatModal {
    padding: 18px;
    overflow: hidden;
    background: rgba(31, 35, 24, 0.62);
  }

  #mobileChatModal .modal-content {
    width: min(520px, calc(100vw - 36px));
    max-width: 520px !important;
    max-height: min(760px, calc(100dvh - 36px)) !important;
    margin: clamp(12px, 5vh, 42px) auto 0;
    background: var(--surface);
    border: 0;
    border-radius: 0;
    display: flex;
    flex-direction: column;
    box-shadow: none;
  }

  #mobileChatModal .modal-header {
    padding: 14px 16px;
    min-height: 58px;
    background: #fffdf8;
    border-bottom: 0;
  }

  #mobileChatModal .modal-header h2 {
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  #mobileChatModal .close {
    width: 36px;
    height: 36px;
    border-radius: 0;
    background: var(--surface-alt);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    line-height: 1.1;
  }

  #mobileChatModal .modal-body {
    flex: 1;
    min-height: 0;
    background: #f2efe4;
  }

  #mobileChatModal .chat-container {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    height: 100%;
    text-align: left !important;
  }

  #mobileChatModal .chat-messages {
    flex: 1;
    min-height: 0;
    max-height: none !important;
    overflow-y: auto;
    padding: 16px;
    scroll-padding-bottom: 96px;
  }

  #mobileChatModal .other-message + .other-message {
    margin-top: 12px;
  }

  #mobileChatModal .message-bubble {
    width: fit-content;
    max-width: 100%;
    padding: 12px 14px;
    border: 0;
    border-radius: 0;
    background: #ffffff;
    box-shadow: none;
  }

  #mobileChatModal .message-bubble span {
    display: block;
    margin: 0 0 4px;
    color: var(--accent-dark);
    font-size: 0.9rem;
    line-height: 1.35;
