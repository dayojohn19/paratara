    const hEsc = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    };
    const ims = {
      images: [],
      index: 0,
      item: null,
    };
    const items = [];
    const rev = {
      packageId: '',
      commentsLoaded: false,
      loading: false,
      nextOffset: 0,
      hasMore: false,
    };
    let canReview = !!config.canReview;
    const loginJsonUrl = config.loginJsonUrl || '/userProfile/loginjson';

    function fv() {
      for (let i = 0; i < arguments.length; i += 1) {
        const value = arguments[i];
        if (value !== undefined && value !== null && String(value).trim() !== '') {
          return value;
        }
      }
      return '';
    }

    function escapeHtml(value) {
      return String(value || '').replace(/[&<>"']/g, function (char) {
        return hEsc[char];
      });
    }

    function normImgs(value) {
      if (Array.isArray(value)) {
        return value
          .map(function (item) {
            if (typeof item === 'string') return item;
            return item && (item.urlField || item.url || item.imageURL || item.src || '');
          })
          .filter(function (url) { return Boolean(url); });
      }
      if (typeof value === 'string' && value.trim() !== '') return [value];
      return [];
    }

    function numVal(value, fallback) {
      const parsed = Number(value);
      return Number.isFinite(parsed) ? parsed : fallback;
    }

    function starsHtml(average, count) {
      const ratingCount = numVal(count, 0);
      if (!ratingCount) return '';
      const ratingValue = Math.max(0, Math.min(5, Math.round(numVal(average, 0))));
      let stars = '';
      for (let i = 1; i <= 5; i += 1) {
        stars += '<span class="rss' + (i <= ratingValue ? ' ia' : '') + '">&#9733;</span>';
      }
      return '<span class="rs" aria-label="' + numVal(average, 0).toFixed(1) + ' out of 5">' + stars + '<span class="rsc">(' + ratingCount + ')</span></span>';
    }

    function ratingStarsHtml(rating) {
      const ratingValue = Math.max(0, Math.min(5, Math.round(numVal(rating, 0))));
      let stars = '';
      for (let i = 1; i <= 5; i += 1) {
        stars += '<span class="rss' + (i <= ratingValue ? ' ia' : '') + '">&#9733;</span>';
      }
      return '<span class="rs" aria-label="' + ratingValue + ' out of 5">' + stars + '</span>';
    }

    function readableReviewTime(value) {
      if (!value) return '';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';
      return date.toLocaleString('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
      });
    }

    function normItem(rawItem, fallbackTitle) {
      const item = rawItem || {};
      let images = normImgs(item.images);
      if (!images.length) images = normImgs(item.package_image);
      if (!images.length) images = normImgs(item.imageURL);
      if (!images.length) images = normImgs(item.resort_Gallery);
      const packageId = fv(item.package_id, item.packageId);
      return Object.assign({}, item, {
        packageId: packageId,
        title: fv(
          item.title,
          item.package_title,
          item.package_name,
          item.PackageTitle,
          item.name,
          fallbackTitle,
          'Item'
        ),
        description: fv(item.description, item.package_description),
        information: fv(item.information, item.package_information),
        price: fv(item.price, item.package_price),
        images: images,
        resortLink: fv(item.resortLink, item.resortURL, item.resort_websiteURL),
        resortName: fv(item.resortName, item.resort_RealName, item.resort_name),
        websiteURL: fv(item.websiteURL, item.website, item.package_website),
        ratingAverage: numVal(fv(item.package_rating_average, item.rating_average, item.ratingAverage), 0),
        ratingCount: numVal(fv(item.package_rating_count, item.rating_count, item.ratingCount), 0),
      });
    }

    function priceText(value, emptyLabel) {
      const label = emptyLabel === undefined ? 'Price not listed' : emptyLabel;
      if (value === undefined || value === null || String(value).trim() === '' || String(value) === '0') {
        return label;
      }
      const numVal = Number(value);
      if (Number.isFinite(numVal)) {
        return '₱' + numVal.toLocaleString();
      }
      const textValue = String(value).trim();
      return textValue.indexOf('₱') === 0 ? textValue : '₱' + textValue;
    }

    function setTxt(id, value) {
      const element = document.getElementById(id);
      if (element) element.textContent = value || '';
      return element;
    }

    function setModalImg(nextIndex) {
      const image = document.getElementById('piI');
      const empty = document.getElementById('piE');
      const counter = document.getElementById('piC');
      const prev = document.getElementById('piP');
      const next = document.getElementById('piN');
      const images = ims.images || [];
      if (!image || !empty) return;

      if (!images.length) {
        image.removeAttribute('src');
        image.style.display = 'none';
        empty.style.display = 'flex';
        if (counter) counter.textContent = '0 / 0';
        if (prev) prev.hidden = true;
        if (next) next.hidden = true;
        return;
      }

      ims.index = (nextIndex + images.length) % images.length;
      image.src = images[ims.index];
      image.alt = ims.item ? ims.item.title : 'Item photo';
      image.style.display = 'block';
      empty.style.display = 'none';
      if (counter) counter.textContent = (ims.index + 1) + ' / ' + images.length;
      if (prev) prev.hidden = images.length <= 1;
      if (next) next.hidden = images.length <= 1;
    }

    window.placeItemModalState = ims;
    window.placeItemDetails = items;
    window.placeEscapeHtml = escapeHtml;
    window.placeNormalizeImages = normImgs;
    window.placeFormatPrice = priceText;
    window.placePageSize = 10;
    window.placeGetPaginatedResults = function (payload, legacyNestedKey) {
      if (payload && Array.isArray(payload.results)) return payload.results;
      const rows = [];
      (Array.isArray(payload) ? payload : []).forEach(function (item) {
        if (item && legacyNestedKey && Array.isArray(item[legacyNestedKey])) {
          rows.push.apply(rows, item[legacyNestedKey]);
        } else if (item) {
          rows.push(item);
        }
      });
      return rows;
    };
    window.placeSetLoadMoreButton = function (containerId, hasNext, isLoading, onClick) {
      const container = document.getElementById(containerId);
      if (!container) return;
      if (!hasNext && !isLoading) {
        container.innerHTML = '';
        container.hidden = true;
        return;
      }
      container.hidden = false;
      container.innerHTML = '<button type="button" class="button button--ghost place-load-more-btn">' + (isLoading ? 'Loading...' : 'Load more') + '</button>';
      const button = container.querySelector('button');
      if (!button) return;
      button.disabled = !!isLoading;
      if (!isLoading) button.addEventListener('click', onClick);
    };
    window.registerPlaceItemDetail = function (rawItem, fallbackTitle) {
      const item = normItem(rawItem, fallbackTitle);
      items.push(item);
      return items.length - 1;
    };
    window.placeBuildItemCard = function (rawItem, fallbackTitle) {
      const item = normItem(rawItem, fallbackTitle);
      const index = window.registerPlaceItemDetail(item, fallbackTitle);
      const imageSrc = item.images[0] || '';
      const ratingHtml = item.packageId ? starsHtml(item.ratingAverage, item.ratingCount) : '';
      const imageTag = imageSrc
        ? `<img src="${escapeHtml(imageSrc)}" alt="${escapeHtml(item.title)}" class="pci"${window.placeLazyImageAttrs || ''} />`
        : '';
      return `
        <button type="button" class="pc pic jpic" data-pi="${index}" aria-label="View ${escapeHtml(item.title)}">
          ${imageTag}
          <span class="pcb">
            <span class="pct">${escapeHtml(item.title)}</span>
            <span class="pcp">${escapeHtml(priceText(item.price))}</span>
            ${ratingHtml ? `<span class="pcr">${ratingHtml}</span>` : ''}
          </span>
        </button>
      `;
    };

    function csrfToken() {
      if (typeof getCookie === 'function') return getCookie('csrftoken') || '';
      return '';
    }

    function setReviewStatus(message, isError) {
      const status = document.getElementById('prS');
      if (!status) return;
      status.textContent = message || '';
      status.style.color = isError ? '#b91c1c' : '#64748b';
    }

    function setReviewSummary(item, average, count) {
      if (item) {
        item.ratingAverage = numVal(average, 0);
        item.ratingCount = numVal(count, 0);
      }
      const summary = document.getElementById('prY');
      if (summary) {
        summary.innerHTML = starsHtml(
          item ? item.ratingAverage : average,
          item ? item.ratingCount : count
        ) || '';
      }
      const modalRating = document.getElementById('piA');
      if (modalRating) {
        const ratingHtml = starsHtml(
          item ? item.ratingAverage : average,
          item ? item.ratingCount : count
        );
        modalRating.innerHTML = ratingHtml;
        modalRating.hidden = !ratingHtml;
      }
    }

    function setStars(value) {
      const rating = Math.max(1, Math.min(5, numVal(value, 0)));
      const ratingField = document.getElementById('prV');
      const label = document.getElementById('psL');
      const stars = document.querySelectorAll('.psrs');

      if (ratingField) ratingField.value = rating ? String(rating) : '';
      if (label) label.textContent = rating ? rating + '/5 selected' : 'Choose rating';
      stars.forEach(function (star) {
        const starRating = numVal(star.getAttribute('data-rating'), 0);
        const active = rating && starRating <= rating;
        star.classList.toggle('ia', !!active);
        star.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    function authFormHtml(title) {
      return `
        <form class="prf paF" data-mode="login">
          <strong class="prat paTitle">${escapeHtml(title || 'Log in to rate')}</strong>
          <input name="contact" type="text" autocomplete="email" placeholder="Contact or email" hidden />
          <input name="username" type="text" autocomplete="username" placeholder="Username" required />
          <input name="password" type="password" autocomplete="current-password" placeholder="Password" required />
          <button type="submit" class="paSubmit">Log in</button>
          <p class="prst"><span class="paHint">New here?</span> <button type="button" class="prlb paSwitch" data-auth-mode="signup">Create account</button>.</p>
          <div class="prst paStatus" aria-live="polite"></div>
        </form>
      `;
    }

    function setAuthStatus(form, message, isError) {
      const status = form && form.querySelector('.paStatus');
      if (!status) return;
      status.textContent = message || '';
      status.style.color = isError ? '#b91c1c' : '#64748b';
    }

    function setAuthMode(mode, form) {
      if (!form) return;
      const signup = mode === 'signup';
      const contact = form.elements.contact;
      const password = form.elements.password;
      const switchButton = form.querySelector('.paSwitch');

      form.dataset.mode = signup ? 'signup' : 'login';
      contact.hidden = !signup;
      contact.required = signup;
      password.autocomplete = signup ? 'new-password' : 'current-password';
      if (signup) {
        password.setAttribute('minlength', '6');
      } else {
        password.removeAttribute('minlength');
      }

      form.querySelector('.paTitle').textContent = signup ? 'Create an account' : (form.dataset.loginTitle || 'Log in to rate');
      form.querySelector('.paSubmit').textContent = signup ? 'Create account' : 'Log in';
      form.querySelector('.paHint').textContent = signup ? 'Already registered?' : 'New here?';
      switchButton.textContent = signup ? 'Log in' : 'Create account';
      switchButton.dataset.authMode = signup ? 'login' : 'signup';

      setAuthStatus(form, '', false);
      (signup ? contact : form.elements.username).focus();
    }

    function renderReviewPanel(item) {
      const panel = document.getElementById('prP');
      if (!panel) return;
      const packageId = item && item.packageId ? String(item.packageId) : '';
      rev.packageId = packageId;
      rev.commentsLoaded = false;
      rev.loading = false;
      rev.nextOffset = 0;
      rev.hasMore = false;

      if (!packageId) {
        panel.hidden = true;
        panel.innerHTML = '';
        return;
      }

      const reviewForm = canReview
        ? `
          <form id="prF" class="prf">
            <div class="prfr">
              <div class="psr" role="radiogroup" aria-label="Rating">
                <input type="hidden" name="rating" id="prV" required />
                <button type="button" class="psrs" data-rating="1" aria-label="1 out of 5" aria-pressed="false">&#9733;</button>
                <button type="button" class="psrs" data-rating="2" aria-label="2 out of 5" aria-pressed="false">&#9733;</button>
                <button type="button" class="psrs" data-rating="3" aria-label="3 out of 5" aria-pressed="false">&#9733;</button>
                <button type="button" class="psrs" data-rating="4" aria-label="4 out of 5" aria-pressed="false">&#9733;</button>
                <button type="button" class="psrs" data-rating="5" aria-label="5 out of 5" aria-pressed="false">&#9733;</button>
                <span id="psL" class="psrl">Choose rating</span>
              </div>
              <textarea name="comment" maxlength="800" placeholder="Comment optional"></textarea>
            </div>
            <button type="submit">Save rating</button>
          </form>
        `
        : authFormHtml('Log in to rate');

      panel.hidden = false;
      panel.innerHTML = `
        <div class="prvs">
          <span id="prY">${starsHtml(item.ratingAverage, item.ratingCount)}</span>
          <button type="button" id="prB" class="prvb">Show comments</button>
        </div>
        ${reviewForm}
        <div id="prS" class="prst" aria-live="polite"></div>
        <div id="prL" class="prl" hidden></div>
        <button type="button" id="prM" class="prvb" hidden>Load more comments</button>
      `;
    }

    function reviewHtml(review) {
      const comment = review.comment
        ? `<p class="prvc">${escapeHtml(review.comment)}</p>`
        : '';
      const reviewTime = readableReviewTime(review.updated_at || review.created_at);
      return `
        <div class="prw">
          <div class="prvm">
            <span>${escapeHtml(review.user_name || 'User')}</span>
            <span>${ratingStarsHtml(review.rating)}</span>
          </div>
          ${reviewTime ? `<div class="prvd">${escapeHtml(reviewTime)}</div>` : ''}
          ${comment}
        </div>
      `;
    }

    async function loadReviews(append) {
      const packageId = rev.packageId;
      if (!packageId || rev.loading) return;
      const list = document.getElementById('prL');
      const loadButton = document.getElementById('prB');
      const moreButton = document.getElementById('prM');
      const offset = append ? rev.nextOffset : 0;

      rev.loading = true;
      if (list) {
        list.hidden = false;
        if (!append) list.innerHTML = '<div class="prst">Loading comments...</div>';
      }
      if (loadButton) {
        loadButton.disabled = true;
        loadButton.textContent = 'Loading...';
      }
      if (moreButton) moreButton.disabled = true;

      try {
        const response = await fetch(`/est/package/${encodeURIComponent(packageId)}/reviews/?limit=5&offset=${offset}`, {
          headers: { 'Accept': 'application/json' },
        });
        if (!response.ok) throw new Error('Failed to load comments');
        const payload = await response.json();
        if (rev.packageId !== packageId) return;

        setReviewSummary(ims.item, payload.rating_average, payload.rating_count);
        const reviews = Array.isArray(payload.reviews) ? payload.reviews : [];
        const html = reviews.map(reviewHtml).join('');
        if (list) {
          if (append) {
            list.insertAdjacentHTML('beforeend', html);
          } else {
            list.innerHTML = html || '<div class="prst">No comments yet.</div>';
          }
        }
        rev.commentsLoaded = true;
        rev.hasMore = !!payload.has_more;
        rev.nextOffset = payload.next_offset || 0;
        if (moreButton) moreButton.hidden = !rev.hasMore;
        setReviewStatus('', false);
      } catch (error) {
        setReviewStatus('Could not load comments right now.', true);
      } finally {
        rev.loading = false;
        if (loadButton) {
          loadButton.disabled = false;
          loadButton.textContent = rev.commentsLoaded ? 'Refresh comments' : 'Show comments';
        }
        if (moreButton) moreButton.disabled = false;
      }
    }

    async function submitReview(form) {
      const packageId = rev.packageId;
      if (!packageId || !form) return;
      const submitButton = form.querySelector('button[type="submit"]');
      const ratingField = form.elements.rating;
      const commentField = form.elements.comment;
      const rating = ratingField ? ratingField.value : '';
      const comment = commentField ? commentField.value : '';

      if (!rating) {
        setReviewStatus('Choose a rating from 1 to 5.', true);
        return;
      }

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Saving...';
      }
      setReviewStatus('', false);

      try {
        const response = await fetch(`/est/package/${encodeURIComponent(packageId)}/review/`, {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-CSRFToken': csrfToken(),
          },
          body: JSON.stringify({ rating: rating, comment: comment }),
        });
        const isJson = (response.headers.get('content-type') || '').indexOf('application/json') !== -1;
        const payload = isJson ? await response.json() : null;
        if (!response.ok || !payload || payload.success === false) {
          throw new Error(payload && payload.error ? payload.error : 'Could not save rating');
        }

        setReviewSummary(ims.item, payload.rating_average, payload.rating_count);
        setReviewStatus('Rating saved.', false);
        if (rev.commentsLoaded) {
          await loadReviews(false);
        }
      } catch (error) {
        setReviewStatus(error.message || 'Could not save rating.', true);
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = 'Save rating';
        }
      }
    }

    async function submitAuth(form) {
      if (!form) return;
      const signup = form.dataset.mode === 'signup';
      const submitButton = form.querySelector('button[type="submit"]');
      const contact = (form.elements.contact ? form.elements.contact.value : '').trim();
      const username = (form.elements.username ? form.elements.username.value : '').trim();
      const password = form.elements.password ? form.elements.password.value : '';

      if (!username || !password || (signup && !contact)) {
        const message = signup
          ? 'Enter contact, username, and password.'
          : 'Enter username and password.';
        setAuthStatus(form, message, true);
        return;
      }

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = signup ? 'Creating...' : 'Logging in...';
      }
      setAuthStatus(form, '', false);

      try {
        const endpoint = signup ? '/userProfile/registerjson' : loginJsonUrl;
        const requestData = signup
          ? {
              username: username,
              contact: contact,
              password: password,
              passwordConfirmation: password,
              placeID: config.placeId,
            }
          : {
              usernameJSON: username,
              passwordJSON: password,
            };
        const response = await fetch(endpoint, {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-CSRFToken': csrfToken(),
          },
          body: JSON.stringify(requestData),
        });
        const payload = await response.json().catch(function () { return null; });
        const loggedIn = Array.isArray(payload) && payload[0] === 'Successfully Log In';
        if (!response.ok || (!signup && !loggedIn)) {
          const message = Array.isArray(payload)
            ? payload[0]
            : (typeof payload === 'string' ? payload : payload && (payload.error || payload.detail));
          throw new Error(message || (signup ? 'Could not create account' : 'Wrong username or password'));
        }

        canReview = true;
        const authModal = form.closest('.pam');
        if (authModal) {
          const onSuccess = authModal._onSuccess;
          authModal.remove();
          if (typeof onSuccess === 'function') onSuccess();
        } else {
          renderReviewPanel(ims.item);
          setReviewStatus(signup ? 'Account created. You can now rate this package.' : 'Logged in. You can now rate this package.', false);
        }
      } catch (error) {
        setAuthStatus(form, error.message || (signup ? 'Could not create account.' : 'Could not log in.'), true);
      } finally {
        if (submitButton && submitButton.isConnected) {
          submitButton.disabled = false;
          submitButton.textContent = signup ? 'Create account' : 'Log in';
        }
      }
    }

    window.placeIsAuthenticated = function () {
      return canReview;
    };
    window.openPlaceAuth = function (onSuccess) {
      if (canReview) {
        if (typeof onSuccess === 'function') onSuccess();
        return;
      }
      if (window.ensurePlaceSubCardStyles) window.ensurePlaceSubCardStyles();
      const oldModal = document.querySelector('.pam');
      if (oldModal) oldModal.remove();
      const modal = document.createElement('div');
      modal.className = 'pam';
      modal.setAttribute('role', 'dialog');
      modal.setAttribute('aria-modal', 'true');
      modal.setAttribute('aria-label', 'Log in or create account');
      modal._onSuccess = onSuccess;
      modal.innerHTML = `<div class="pamc"><button type="button" class="pamx" aria-label="Close">&times;</button>${authFormHtml('Log in to continue')}</div>`;
      document.body.appendChild(modal);
      const form = modal.querySelector('.paF');
      form.dataset.loginTitle = 'Log in to continue';
      form.elements.username.focus();
    };

    window.openPlaceItemModal = function (itemOrIndex) {
      const modal = document.getElementById('piM');
      if (!modal) return;
      const item = typeof itemOrIndex === 'number'
        ? items[itemOrIndex]
        : normItem(itemOrIndex || {});
      if (!item) return;

      if (window.ensurePlaceSubCardStyles) window.ensurePlaceSubCardStyles();
      ims.item = item;
      ims.images = item.images || [];
      ims.index = 0;

      setTxt('piT', item.title);
      setTxt('piR', item.resortName);
      setTxt('piPrice', priceText(item.price));
      setReviewSummary(item, item.ratingAverage, item.ratingCount);
      const description = [item.description, item.information].filter(Boolean).join('\n\n');
      const descriptionElement = setTxt('piD', description);
      if (descriptionElement) {
        descriptionElement.hidden = !description;
      }

      const link = document.getElementById('piL');
      const linkUrl = item.resortLink || item.websiteURL || '';
      if (link && linkUrl) {
        link.href = linkUrl;
        link.textContent = item.resortLink ? 'View Resort' : 'Open Link';
        link.hidden = false;
      } else if (link) {
        link.hidden = true;
        link.removeAttribute('href');
      }

      setModalImg(0);
      renderReviewPanel(item);
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };
    window.closePlaceItemModal = function () {
      const modal = document.getElementById('piM');
      const image = document.getElementById('piI');
      if (image) image.removeAttribute('src');
      if (modal) {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
      }
      document.body.style.overflow = '';
    };
    window.shiftPlaceItemModalImage = function (direction) {
      setModalImg(ims.index + direction);
    };

    runWhenReady(function () {
      const closeButton = document.getElementById('piX');
      const prevButton = document.getElementById('piP');
      const nextButton = document.getElementById('piN');
      if (closeButton) closeButton.addEventListener('click', window.closePlaceItemModal);
      if (prevButton) prevButton.addEventListener('click', function () { window.shiftPlaceItemModalImage(-1); });
      if (nextButton) nextButton.addEventListener('click', function () { window.shiftPlaceItemModalImage(1); });

      document.addEventListener('click', function (event) {
        const card = event.target && event.target.closest ? event.target.closest('.jpic') : null;
        if (!card) return;
        const index = Number(card.getAttribute('data-pi'));
        if (Number.isFinite(index)) window.openPlaceItemModal(index);
      });

      document.addEventListener('click', function (event) {
        const loadButton = event.target && event.target.closest ? event.target.closest('#prB') : null;
        if (loadButton) {
          loadReviews(false);
          return;
        }
        const authSwitch = event.target && event.target.closest ? event.target.closest('.paSwitch') : null;
        if (authSwitch) {
          setAuthMode(authSwitch.dataset.authMode, authSwitch.closest('.paF'));
          return;
        }
        const authClose = event.target && event.target.closest ? event.target.closest('.pamx') : null;
        if (authClose) {
          authClose.closest('.pam').remove();
          return;
        }
        if (event.target && event.target.classList && event.target.classList.contains('pam')) {
          event.target.remove();
          return;
        }
        const starButton = event.target && event.target.closest ? event.target.closest('.psrs') : null;
        if (starButton) {
          setStars(starButton.getAttribute('data-rating'));
          return;
        }
        const moreButton = event.target && event.target.closest ? event.target.closest('#prM') : null;
        if (moreButton) loadReviews(true);
      });

      document.addEventListener('submit', function (event) {
        if (!event.target || (event.target.id !== 'prF' && !event.target.classList.contains('paF'))) return;
        event.preventDefault();
        if (event.target.classList.contains('paF')) {
          submitAuth(event.target);
        } else {
          submitReview(event.target);
        }
      });

      document.addEventListener('keydown', function (event) {
        const authModal = document.querySelector('.pam');
        if (event.key === 'Escape' && authModal) {
          authModal.remove();
          return;
        }
        const modal = document.getElementById('piM');
        if (!modal || !modal.classList.contains('is-open')) return;
        if (event.key === 'Escape') window.closePlaceItemModal();
        if (event.key === 'ArrowLeft') window.shiftPlaceItemModalImage(-1);
        if (event.key === 'ArrowRight') window.shiftPlaceItemModalImage(1);
      });
    });
  }());

  function openBulletinImageModal(imageUrl) {
    const modal = document.getElementById('bulletinImageModal');
    const imageElement = document.getElementById('bulletinModalImage');
    if (!modal || !imageElement) return;
    imageElement.src = imageUrl;
    modal.style.display = 'block';
    modal.setAttribute('aria-hidden', 'false');
  }

  function closeBulletinImageModal() {
    const modal = document.getElementById('bulletinImageModal');
    const imageElement = document.getElementById('bulletinModalImage');
    if (imageElement) imageElement.src = '';
    if (modal) {

      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
    }
  }

  document.addEventListener('click', function(event) {
    const link = event.target && event.target.closest ? event.target.closest('a.bulletin-image-link') : null;
    if (!link) return;
    event.preventDefault();
    const imageUrl = link.getAttribute('data-image-url') || link.getAttribute('href');
    if (!imageUrl) return;
    openBulletinImageModal(imageUrl);
  });

  window.placePageReady(function() {
    const button = document.getElementById('bulletinPostButton');
    const form = document.getElementById('bulletinPostForm');
    if (!button || !form) return;

    button.addEventListener('click', function() {
      const isHidden = form.style.display === 'none' || form.style.display === '';
      form.style.display = isHidden ? 'flex' : 'none';
    });
  });

  window.placePageReady(function () {
    const navToggle = document.getElementById('placeNavToggle');
    const navMenu = document.getElementById('placeNavMenu');
    if (!navToggle || !navMenu) return;

    const navOpenMap = document.getElementById('placeNavOpenMap');

    function closeMenu() {
      navMenu.classList.remove('is-open');
      navToggle.setAttribute('aria-expanded', 'false');
    }

    navToggle.addEventListener('click', function () {
      const isOpen = navMenu.classList.toggle('is-open');
      navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    navMenu.addEventListener('click', function (event) {
      const actionable = event.target && event.target.closest ? event.target.closest('a, button') : null;
      if (!actionable) return;
      closeMenu();
    });

    if (navOpenMap) {
      navOpenMap.addEventListener('click', function (event) {
        if (event && event.preventDefault) event.preventDefault();
        const existing = document.getElementById('openMapBtn');
        if (existing) existing.click();
      });
    }

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeMenu();
    });
  });
