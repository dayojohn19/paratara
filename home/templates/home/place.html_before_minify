  function formatModelDate(datestr) {
    let d = new Date(datestr)
    return d.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    })
  }

  let currentPage = 1;
  const blogsPerPage = 4;
  let allBlogs = [];
  let pendingBlogPlaceName = '';
  let blogsLoadScheduled = false;

  async function loadBlogs(placeName) {
    if (!placeName) return;
    const base = window.location.origin;
    const res = await fetch(`${base}/apis/getPlaceBlogs/${placeName}/`);
    if (!res.ok) return;

    allBlogs = await res.json();
    currentPage = 1;
    renderBlogs();
  }

  function scheduleBlogsLoad(placeName) {
    pendingBlogPlaceName = placeName;
    if (blogsLoadScheduled) return;

    blogsLoadScheduled = true;
    const blogSection = document.getElementById("blogs");
    if (window.placeWhenVisible) {
      window.placeWhenVisible(blogSection, function () {
        loadBlogs(pendingBlogPlaceName);
      }, { rootMargin: '600px 0px' });
    } else {
      loadBlogs(pendingBlogPlaceName);
    }
  }

  function renderBlogs() {
    const container = document.getElementById("blog-grid");
    const paginationContainer = document.getElementById("blog-pagination");

    if (!allBlogs.length) {
      container.innerHTML = '<div class="empty-state">No blog posts yet.</div>';
      if (paginationContainer) paginationContainer.innerHTML = '';
      return;
    }

    const totalPages = Math.ceil(allBlogs.length / blogsPerPage);
    const startIndex = (currentPage - 1) * blogsPerPage;
    const endIndex = startIndex + blogsPerPage;
    const blogsToShow = allBlogs.slice(startIndex, endIndex);


const cards = blogsToShow
  .map(blog => {
    const categoryClass = blog.category
      .toLowerCase()
      .replace(/\s+/g, '-');

    return `
      <div class="blog-post">
        <h3 class="blog-title">          <span class="blog-category category-${categoryClass}">
            ${blog.category}
          </span> ${blog.title} </h3>



        <p class="blog-excerpt">${blog.summarize}</p>

        <div class="blog-meta">
          <div class="blog-meta-left">
            <span class="blog-meta-item">
              📅 ${formatModelDate(blog.updated_at)} 
            </span>

            <span class="blog-meta-item">
              ⏱️ ${blog.readtime} min read
            </span>
          </div>

          <a href="${blog.localurlpath}/" class="blog-card" onclick="openModalWithContent(event, this.href)" >
            <span>Read here →</span>
          </a>
        </div>
      </div>
    `;
  })
  .join("");

container.innerHTML = cards;
    // Render pagination controls
    renderPagination(totalPages);
  }

  function renderPagination(totalPages) {
    const paginationContainer = document.getElementById("blog-pagination");
    if (!paginationContainer) return;

    if (totalPages <= 1) {
      paginationContainer.innerHTML = '';
      return;
    }

    let paginationHTML = '<div class="pagination-controls">';

    // Previous button
    if (currentPage > 1) {
      paginationHTML += `<button class="pagination-btn" onclick="changePage(${currentPage - 1})">← Previous</button>`;
    }

    // Page numbers
    const startPage = Math.max(1, currentPage - 2);
    const endPage = Math.min(totalPages, currentPage + 2);

    if (startPage > 1) {
      paginationHTML += `<button class="pagination-btn" onclick="changePage(1)">1</button>`;
      if (startPage > 2) {
        paginationHTML += '<span class="pagination-dots">...</span>';
      }
    }

    for (let i = startPage; i <= endPage; i++) {
      const activeClass = i === currentPage ? ' active' : '';
      paginationHTML += `<button class="pagination-btn${activeClass}" onclick="changePage(${i})">${i}</button>`;
    }

    if (endPage < totalPages) {
      if (endPage < totalPages - 1) {
        paginationHTML += '<span class="pagination-dots">...</span>';
      }
      paginationHTML += `<button class="pagination-btn" onclick="changePage(${totalPages})">${totalPages}</button>`;
    }

    // Next button
    if (currentPage < totalPages) {
      paginationHTML += `<button class="pagination-btn" onclick="changePage(${currentPage + 1})">Next →</button>`;
    }

    paginationHTML += '</div>';
    paginationContainer.innerHTML = paginationHTML;
  }

  function changePage(page) {
    currentPage = page;
    renderBlogs();
    // Scroll to top of blog section
    const blogSection = document.getElementById("blogs");
    if (blogSection) {
      blogSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
</script>

