<script>
    // Generate math challenge
    let mathA, mathB, mathCorrectAnswer;
    function generateMathChallenge() {
      mathA = Math.floor(Math.random() * 10) + 1;
      mathB = Math.floor(Math.random() * 10) + 1;
      mathCorrectAnswer = mathA + mathB;
      const mathQuestion = document.getElementById('mathQuestion');
      if (mathQuestion) {
        mathQuestion.textContent = `${mathA} + ${mathB}`;
      }
    }  
  // Get CSRF token from cookie for Django POST requests
  function getCookie(name) {
    let cookieValue = null;
    if (document.cookie && document.cookie !== '') {
      const cookies = document.cookie.split(';');
      for (let i = 0; i < cookies.length; i++) {
        const cookie = cookies[i].trim();
        if (cookie.substring(0, name.length + 1) === (name + '=')) {
          cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
          break;
        }
      }
    }
    return cookieValue;
  }
  const csrftoken = getCookie('csrftoken');

  // Get user's geolocation
  function getUserLocation() {
    return new Promise((resolve, reject) => {
      if (!navigator.geolocation) {
        reject(new Error('Geolocation is not supported by this browser'));
        return;
      }

      navigator.geolocation.getCurrentPosition(
        (position) => {
          const coords = {
            latitude: position.coords.latitude,
            longitude: position.coords.longitude,
            accuracy: position.coords.accuracy
          };
          resolve(coords);
        },
        (error) => {
          console.warn('Geolocation error:', error);
          // Don't reject - allow joining without location
          resolve(null);
        },
        {
          enableHighAccuracy: true,
          timeout: 10000,
          maximumAge: 0
        }
      );
    });
  }

  // Handle schedule join with confirmation and geolocation
  async function joinSchedule(scheduleId, scheduleTitle) {
    // Show confirmation dialog
    const isConfirmed = confirm(`Are you sure you want to join "${scheduleTitle}"?`);
    
    if (!isConfirmed) {
      return;
    }

    // Check if user is logged in first
    const currentPageUser = '{{request.user}}';
    if (currentPageUser === "AnonymousUser") {
      alert('You must be logged in to join a schedule. Please log in first.');
      window.location.href = '/userProfile/login/';
      return;
    }

    // Request user's location
    let userLocation = null;
    let manualPickLocation = '';
    try {
      userLocation = await getUserLocation();
      if (userLocation) {
        console.log('Location obtained:', userLocation);
      } else {
        console.log('Location permission denied or unavailable');
      }
    } catch (error) {
      console.error('Error getting location:', error);
      // Continue without location
    }

    // If we don't have GPS coordinates, prompt the user to enter a pickup location
    if (!userLocation) {
      manualPickLocation = (prompt('We could not access your location. Please enter your pick-up location address') || '').trim();

      if (!manualPickLocation) {
        alert('Pickup location is required to join this schedule.');
        return;
      }

      // If user entered "lat,lng", also populate pickCoordinate
      const match = manualPickLocation.match(/^\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*$/);
      if (match) {
        const latitude = Number(match[1]);
        const longitude = Number(match[2]);

        if (Number.isFinite(latitude) && Number.isFinite(longitude)) {
          userLocation = { latitude, longitude };
        }
      }
    }

    // Prepare form data
    const formData = new FormData();
    const manualContact = (prompt('Enter your Contact Details') || '').trim();
    formData.append('pickContact', manualContact);
    if (userLocation) {
      formData.append('pickCoordinate', JSON.stringify(userLocation));
      formData.append('pickLocation', `${userLocation.latitude},${userLocation.longitude}`);
    } else if (manualPickLocation) {
      formData.append('pickLocation', manualPickLocation);
    }

    // Send request to join
    fetch(`/schedule/${scheduleId}/join/`, {
      method: 'POST',
      headers: {
        'X-CSRFToken': csrftoken,
      },
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      if (data.success || data.already_joined) {
        alert(data.message || 'Successfully joined the schedule!');
        // Optionally refresh the page or update UI
        // window.location.reload();
      } else if (response.status === 401) {
        alert('Please log in to join this schedule');
        window.location.href = '/userProfile/login/';
      } else {
        alert(data.error || 'Failed to join schedule');
      }
    })
    .catch(error => {
      console.error('Error joining schedule:', error);
      alert('An error occurred while joining. Please try again.');
    });
  }

  async function viewJoiners(scheduleId, scheduleTitle) {
    // Check if user is logged in
    const currentPageUser = '{{request.user}}';
    if (currentPageUser === "AnonymousUser") {
      alert('You must be logged in to view joiners.');
      window.location.href = '/userProfile/login/';
      return;
    }

    try {
      const response = await fetch(`/api/schedule/${scheduleId}/joiners/`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRFToken': csrftoken
        }
      });

      if (response.ok) {
        const data = await response.json();
        if (data.joiners && data.joiners.length > 0) {
          // Display joiners in a modal or alert
          let joinersHTML = `<h3>Joiners for "${scheduleTitle}"</h3><ul style="text-align: left;">`;
          data.joiners.forEach(joiner => {
            joinersHTML += `<li>
              <strong>${joiner.userName || 'Anonymous'}</strong><br>
              📍 Pick Location: ${pickLocationToHtml(joiner.pickLocation)}<br>
              📞 Contact: ${joiner.contact || 'N/A'}<br>
              <small>Joined: ${new Date(joiner.timestamp).toLocaleString()}</small>
            </li>`;
          });
          joinersHTML += '</ul>';
          
          // Create and show modal
          const modal = document.createElement('div');
          modal.style.cssText = `
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
          `;
          modal.innerHTML = `
          <div style="background: white; padding: 30px; max-width: 500px; max-height: 80vh; overflow-y: auto;">
              ${joinersHTML}
              <button onclick="this.closest('div').parentElement.remove()" style="margin-top: 20px; padding: 10px 20px; background: #667eea; color: white; border: none; cursor: pointer;">Close</button>
            </div>
          `;
          document.body.appendChild(modal);
        } else {
          alert('No one has joined this schedule yet.');
        }
      } else {
        alert('Failed to load joiners. Please try again.');
      }
    } catch (error) {
      console.error('Error fetching joiners:', error);
      alert('An error occurred while loading joiners. Please try again.');
    }
  }

  async function deleteSchedule(scheduleId, scheduleTitle, clickedButton) {
    const isConfirmed = confirm(`Are you sure you want to delete "${scheduleTitle}"? This cannot be undone.`);
    if (!isConfirmed) {
      return;
    }

    // Check if user is logged in
    const currentPageUser = '{{request.user}}';
    if (currentPageUser === "AnonymousUser") {
      alert('You must be logged in to delete a schedule.');
      window.location.href = '/userProfile/';
      return;
    }

    try {
      const response = await fetch(`/schedule/${scheduleId}/delete/`, {
        method: 'POST',
        headers: {
          'X-CSRFToken': csrftoken,
        },
      });

      const data = await response.json().catch(() => ({}));

      if (response.ok && data.success) {
        alert(data.message || 'Schedule deleted');
        const card = clickedButton && clickedButton.closest ? clickedButton.closest('.schedule-card') : null;
        if (card) {
          card.remove();
        } else {
          window.location.reload();
        }
        return;
      }

      if (response.status === 401) {
        alert('Please log in to delete this schedule.');
        window.location.href = '/userProfile/';
        return;
      }

      alert((data && (data.error || data.message)) || 'Failed to delete schedule');
    } catch (error) {
      console.error('Error deleting schedule:', error);
      alert('An error occurred while deleting. Please try again.');
    }
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function parseLatLng(text) {
    const match = String(text || '').match(/^\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*$/);
    if (!match) return null;

    const latitude = Number(match[1]);
    const longitude = Number(match[2]);
    if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) return null;
    if (latitude < -90 || latitude > 90) return null;
    if (longitude < -180 || longitude > 180) return null;

    return { latitude, longitude };
  }

  function googleMapsDirectionsUrl(latitude, longitude) {
    const destination = encodeURIComponent(`${latitude},${longitude}`);
    return `https://www.google.com/maps/dir/?api=1&destination=${destination}`;
  }

  function pickLocationToHtml(pickLocation) {
    if (!pickLocation) return 'Not specified';

    const parsed = parseLatLng(pickLocation);
    if (!parsed) return escapeHtml(pickLocation);

    const coordsLabel = escapeHtml(`${parsed.latitude},${parsed.longitude}`);
    const href = googleMapsDirectionsUrl(parsed.latitude, parsed.longitude);
    return `${coordsLabel} — <a href="${href}" target="_blank" rel="noopener noreferrer" style="color: #667eea; text-decoration: underline;">Get directions</a>`;
  }

  function convertMarkdownLinks(text) {
    // Convert markdown links [text](url) to HTML anchor tags
    return String(text || '').replace(/\[([^\]]+)\]\(([^\)]+)\)/g, '<a href="$2" target="_blank" style="color: #667eea; text-decoration: underline;">$1</a>');
  }

  function discussionViewer(placeID, method) {
    const discussionNode = document.getElementById("allDiscussion");
    if (!discussionNode) return Promise.resolve();

    const username = localStorage.getItem('username') || '';
    const userID = localStorage.getItem('userID') || '';

    return fetch(`/discuss/${placeID}`, {
      method: method,
      headers: {
        'Content-Type': 'application/json',
        'X-CSRFToken': csrftoken
      },
      body: JSON.stringify({
        message: "",
        username: username,
        userID: userID
      }),
    })
      .then((response) => response.json())
      .then((data) => {
        (data.response || []).forEach(discussionBuilder);
      });
  }

  let discussionHistoryPromise = null;
  function ensureDiscussionHistory() {
    if (!discussionHistoryPromise) {
      discussionHistoryPromise = discussionViewer(`{{placeid}}`, 'POST').catch((error) => {
        discussionHistoryPromise = null;
        console.error('Failed to load discussions:', error);
      });
    }
    return discussionHistoryPromise;
  }

  // Spam protection variables
  let lastMessageTime = 0;
  const MESSAGE_COOLDOWN = 10000; // 10 seconds between messages
  const RATE_LIMIT_WINDOW = 60000; // 1 minute
  const MAX_MESSAGES_PER_MINUTE = 5;
  const renderedDiscussionKeys = new Set();

  function discussionFetcher(placeID, method, button) {
    const messageInput = document.querySelector("#discuss-message");
    const message = messageInput.value.trim();
    
    // Validation
    if (message === "") {
      return Promise.resolve();
    }
    
    if (message.length < 2) {
      alert("Message is too short. Please write at least 2 characters.");
      return Promise.resolve();
    }
    
    // Check cooldown
    const now = Date.now();
    const timeSinceLastMessage = now - lastMessageTime;
    
    if (timeSinceLastMessage < MESSAGE_COOLDOWN) {
      const remainingSeconds = Math.ceil((MESSAGE_COOLDOWN - timeSinceLastMessage) / 1000);
      alert(`Please wait ${remainingSeconds} seconds before sending another message.`);
      return Promise.resolve();
    }
    
    // Check rate limit
    const storedData = localStorage.getItem('messageTimestamps');
    let timestamps = storedData ? JSON.parse(storedData) : [];
    timestamps = timestamps.filter(t => now - t < RATE_LIMIT_WINDOW);
    
    if (timestamps.length >= MAX_MESSAGES_PER_MINUTE) {
      alert("Rate limit exceeded. Please wait a minute before sending more messages.");
      return Promise.resolve();
    }
    
    // Clear input and disable button
    messageInput.value = "";
    button.disabled = true;
    
    // Replace button content with spinner
    const originalContent = button.innerHTML;
    button.innerHTML = '<div class="spinner"></div>';
    
    const username = localStorage.getItem('username') || '';
    const userID = localStorage.getItem('userID') || '';
    
    return fetch(`/discuss/${placeID}`, {
      method: method,
      headers: {
        'Content-Type': 'application/json',
        'X-CSRFToken': csrftoken
      },
      body: JSON.stringify({
        message: message,
        username: username,
        userID: userID
      }),
    })
      .then((response) => {
        if (!response.ok) {
          return response.json().then(err => {
            throw new Error(err.error || 'Failed to send message');
          });
        }
        return response.json();
      })
      .then((data) => {
        if (data.blog_url) {
          discussionBuilder({
            discusserName: "Paratara",
            discuss: `Blog ready: [Open blog](${data.blog_url})`,
            timestamp: new Date().toISOString()
          });

          lastMessageTime = now;
          timestamps.push(now);
          localStorage.setItem('messageTimestamps', JSON.stringify(timestamps));

          button.disabled = false;
          button.innerHTML = originalContent;
          return;
        }

        if (!data.response || data.response.length === 0) {
          button.disabled = false;
          button.innerHTML = originalContent;
          return;
        }

        if (data.response[1]) discussionBuilder(data.response[1]);
        discussionBuilder(data.response[0]);
        
        // Update spam protection tracking
        lastMessageTime = now;
        timestamps.push(now);
        localStorage.setItem('messageTimestamps', JSON.stringify(timestamps));
        
        // Re-enable button and restore content
        button.disabled = false;
        button.innerHTML = originalContent;
      })
      .catch((error) => {
        console.error('Error sending message:', error);
        alert(error.message || 'Failed to send message. Please try again.');
        
        // Restore input value on error
        messageInput.value = message;
        
        // Re-enable button
        button.disabled = false;
        button.innerHTML = originalContent;
      });
  }

  function discussionBuilder(element) {
    const discusslists = document.getElementById("allDiscussion");
    if (!element || !discusslists) return;

    const discussionKey = [
      element.discusserName || '',
      element.discuss || '',
      element.timestamp || ''
    ].join('|');
    if (renderedDiscussionKeys.has(discussionKey)) return;
    renderedDiscussionKeys.add(discussionKey);

    const discussContainer = document.createElement("div");
    const newDate = new Date(element.timestamp);
    const options = {
      year: "numeric",
      month: "long",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit"
    };
    let formattedDate = newDate.toLocaleString("en-US", options);

    discussContainer.classList.add("other-message");
    discussContainer.classList.add("user-message");

    const discuss = document.createElement("div");
    discuss.classList.add("message-bubble")
    // Convert markdown links to HTML before inserting
    const messageWithLinks = convertMarkdownLinks(element.discuss);
    discuss.innerHTML = `<span>${element.discusserName}:</span> ${messageWithLinks} <div class="message-time">${formattedDate}</div>`;

    discussContainer.appendChild(discuss);
    const firstDiscussionMessage = discusslists.firstChild;
    discusslists.insertBefore(discussContainer, firstDiscussionMessage);
  }


