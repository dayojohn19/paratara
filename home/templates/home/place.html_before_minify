}

/* border ONLY between links */
.top-nav__links a:not(:last-child)::after {
  content: "";
  position: absolute;

  bottom: -2px;
  left: 50%;
  transform: translateX(-50%);

  width: 80%;
  height: 2px;

  background: var(--accent-dark);

  /* pointed edges */
  clip-path: polygon(
    0% 50%,
    3% 0%,
    97% 0%,
    100% 50%,
    97% 100%,
    3% 100%
  );
}


