<script>


const communityBulletinState = { offset: 10, loading: false, hasNext: true };

function renderCommunityBulletinPost(post) {
  const images = Array.isArray(post.images) ? post.images.filter(Boolean) : [];
  const firstImage = images[0] || '';
  const title = post.ai_title || 'Community bulletin';
  const canDelete = "{{ user.is_superuser|yesno:'true,false' }}" === "true";
  const imageBlock = firstImage ? `
    <div style="width:100%; height:160px; overflow:hidden;">
      <a href="${window.placeEscapeHtml(firstImage)}" class="bulletin-image-link" data-image-url="${window.placeEscapeHtml(firstImage)}" style="display:block; width:100%; height:160px;">
        <img src="${window.placeEscapeHtml(firstImage)}" alt="${window.placeEscapeHtml(title)}" loading="lazy" decoding="async" style="width:100%; height:160px; object-fit:cover;" />
      </a>
    </div>
  ` : '';
  const thumbnails = images.length > 1 ? `
    <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:10px;">
      ${images.map(function (imageUrl) {
        return `
          <a href="${window.placeEscapeHtml(imageUrl)}" class="bulletin-image-link" data-image-url="${window.placeEscapeHtml(imageUrl)}" style="display:inline-block;">
            <img src="${window.placeEscapeHtml(imageUrl)}" alt="Bulletin photo" loading="lazy" decoding="async" style="width:64px; height:64px; object-fit:cover;" />
          </a>
        `;
      }).join('')}
    </div>
  ` : '';
  const deleteUrl = "{% url 'home:community_bulletin_delete' placeid 0 %}".replace('/0/delete/', '/' + post.id + '/delete/');
  const adminBlock = canDelete ? `
    <div style="padding: 12px;">
      <form method="post" action="${deleteUrl}" style="display:flex; justify-content:flex-end; margin-bottom: 6px;">
        <input type="hidden" name="csrfmiddlewaretoken" value="${window.placeEscapeHtml(csrftoken || '')}" />
        <button type="submit" class="button button--ghost" style="border-color: #e2e8f0;">Delete</button>
      </form>
      <div style="font-weight: 800; margin-bottom: 6px;">${window.placeEscapeHtml(title)}</div>
      ${thumbnails}
    </div>
  ` : '';
  return `<div class="calendar-item" style="overflow:hidden;">${imageBlock}${adminBlock}</div>`;
}

async function loadMoreCommunityBulletins() {
  if (communityBulletinState.loading || !communityBulletinState.hasNext) return;
  const grid = document.getElementById('community-bulletin-grid');
  if (!grid) return;
  communityBulletinState.loading = true;
  window.placeSetLoadMoreButton('community-bulletin-load-more', true, true, function () {});
  try {
    const params = new URLSearchParams({
      limit: String(window.placePageSize || 10),
      offset: String(communityBulletinState.offset),
    });
    const response = await fetch(`{% url 'home:community_bulletin_list' placeid %}?${params.toString()}`, {
      headers: { Accept: 'application/json' },
    });
    if (!response.ok) throw new Error('Failed to fetch bulletin posts');
    const payload = await response.json();
    const posts = Array.isArray(payload.posts) ? payload.posts : [];
    if (posts.length) {
      grid.insertAdjacentHTML('beforeend', posts.map(renderCommunityBulletinPost).join(''));
    }
    const pagination = payload.pagination || {};
    communityBulletinState.offset = pagination.next_offset || communityBulletinState.offset + posts.length;
    communityBulletinState.hasNext = !!pagination.has_next;
    window.placeSetLoadMoreButton('community-bulletin-load-more', communityBulletinState.hasNext, false, loadMoreCommunityBulletins);
  } catch (error) {
    window.placeSetLoadMoreButton('community-bulletin-load-more', true, false, loadMoreCommunityBulletins);
  } finally {
    communityBulletinState.loading = false;
  }
}


