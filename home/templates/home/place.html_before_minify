      <div id="resort-activities-list-js"></div>
      <div id="resort-activities-load-more" class="load-more-wrap" hidden></div>
      <script>
        const resortActivitiesPagination = { offset: 0, loading: false };
        async function fetchAndRenderResortActivities(placeId, append) {
          const container = document.getElementById('resort-activities-list-js');
          if (!container) return;
          if (resortActivitiesPagination.loading) return;
          if (window.ensurePlaceSubCardStyles) window.ensurePlaceSubCardStyles();
          resortActivitiesPagination.loading = true;
          if (!append) {
            resortActivitiesPagination.offset = 0;
            container.innerHTML = '<div class="loading-symbol"></div>';
          }
          window.placeSetLoadMoreButton('resort-activities-load-more', true, true, function () {});
          try {
            const params = new URLSearchParams({
              flat: '1',
              paginate: '1',
              limit: String(window.placePageSize || 10),
              offset: String(resortActivitiesPagination.offset),
            });
            const res = await fetch(`/apis/getPlaceActivities/${placeId}/?${params.toString()}`);
            if (!res.ok) throw new Error('Failed to fetch activities');
            const payload = await res.json();
            const activities = window.placeGetPaginatedResults(payload, 'ActivitiesList');
            if (!activities.length) {
              if (!append) container.innerHTML = '<div class="empty-state">No activities found for this place.</div>';
              window.placeSetLoadMoreButton('resort-activities-load-more', false, false, function () {});
              return;
            }
            if (!append || !document.getElementById('resort-activities-grid')) {
              container.innerHTML = '<div class="resort-activities-block" style="margin-bottom: 24px;"><div class="pcg" id="resort-activities-grid"></div></div>';
            }
            let html = '';
            activities.forEach(activity => {
              const groupTitle = activity.groupTitle || activity.PackageTitle || activity.package_title || activity.title || 'Activity';
              if (activity.subPackagesList && activity.subPackagesList.length > 0) {
                activity.subPackagesList.forEach(sub => {
                  html += window.placeBuildItemCard(Object.assign({}, activity, sub, {
                    PackageTitle: sub.title || activity.PackageTitle,
                    resortLink: sub.resortLink || activity.resortLink,
                    resortName: sub.resortName || activity.resortName,
                    websiteURL: sub.websiteURL || sub.website || activity.websiteURL || activity.website || '',
                  }), groupTitle);
                });
              } else {
                html += window.placeBuildItemCard(activity, groupTitle);
              }
            });
            const grid = document.getElementById('resort-activities-grid');
            if (grid) grid.insertAdjacentHTML('beforeend', html);
            resortActivitiesPagination.offset = payload && payload.next_offset !== null && payload.next_offset !== undefined
              ? payload.next_offset
              : resortActivitiesPagination.offset + activities.length;
            window.placeSetLoadMoreButton('resort-activities-load-more', !!(payload && payload.has_next), false, function () {
              fetchAndRenderResortActivities(placeId, true);
            });
          } catch (e) {
            if (!append) container.innerHTML = '<div class="empty-state">Failed to load activities.</div>';
            window.placeSetLoadMoreButton('resort-activities-load-more', !!append, false, function () {
              fetchAndRenderResortActivities(placeId, true);
            });
          } finally {
            resortActivitiesPagination.loading = false;
          }
        }
        window.placePageReady(function() {
          window.placeWhenVisible(document.getElementById('things-to-do'), function () {
            fetchAndRenderResortActivities('{{ placeid }}', false);
          });
        });
      </script>
