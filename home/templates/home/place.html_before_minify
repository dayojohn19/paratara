// Close button
const closeBlogModalButton = document.getElementById("closemodalpageBtn");
if (closeBlogModalButton) {
  closeBlogModalButton.addEventListener("click", () => {
    const modal = document.getElementById("modal-for-blog-id");
    const modalContentframe = document.getElementById("modalforblogContentframe");
    if (modal) modal.classList.remove("show");
