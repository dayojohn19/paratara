<script>
  const placePlanPagination = {
    eventOffset: 0,
    eventHasNext: false,
    eventLoading: false,
    scheduleOffset: 0,
    scheduleHasNext: false,
    scheduleLoading: false,
  };

  function buildPlacePlanUrl(params) {
    const base = window.placePlanBaseUrl || '';
    const joiner = base.indexOf('?') === -1 ? '?' : '&';
    return base + joiner + new URLSearchParams(params).toString();
  }

  function loadMorePlaceEvents() {
    if (placePlanPagination.eventLoading || !placePlanPagination.eventHasNext) return;
    placePlanPagination.eventLoading = true;
    window.placeSetLoadMoreButton('events-load-more', true, true, function () {});
    getPlan(buildPlacePlanUrl({
      include_resorts: '0',
      track_view: '0',
      event_limit: String(window.placePageSize || 10),
      event_offset: String(placePlanPagination.eventOffset),
      schedule_limit: '0',
      schedule_offset: '0',
    }), { appendEvents: true, renderSchedules: false, skipBlogs: true });
  }

  function loadMorePlaceSchedules() {
    if (placePlanPagination.scheduleLoading || !placePlanPagination.scheduleHasNext) return;
    placePlanPagination.scheduleLoading = true;
    window.placeSetLoadMoreButton('schedules-load-more', true, true, function () {});
    getPlan(buildPlacePlanUrl({
      include_resorts: '0',
      track_view: '0',
      event_limit: '0',
      event_offset: '0',
      schedule_limit: String(window.placePageSize || 10),
      schedule_offset: String(placePlanPagination.scheduleOffset),
    }), { appendSchedules: true, renderEvents: false, skipBlogs: true });
  }

  function getPlan(whatPlan, options) {
    options = options || {};

    return fetch(whatPlan, {
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json",
      },
    })
      .then((response) => {
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
      })
      .then((data) => {
        if (typeof options.beforeRender === 'function') options.beforeRender(data);
        const calendarContainer = document.getElementById('calendar-container');
        const renderedMonth = parseInt(data.month, 10) || parseInt(calendarContainer.dataset.month, 10);
        const placeName = data['placeName'];
        const placeNameElement = document.getElementById("place-name");
        const endPlaceElement = document.getElementById("endPlace");
        if (placeNameElement) placeNameElement.innerText = placeName;
        if (endPlaceElement) endPlaceElement.value = placeName;
        // document.querySelector("#map-modal").src = c;
        if (!options.skipBlogs) scheduleBlogsLoad(placeName);

        const placeEventItems = data['placeEvents'] || [];
        const today = new Date();
        today.setHours(0, 0, 0, 0); // Reset time to midnight for accurate date comparison

        let scheduleCount = 0;
        if (options.renderEvents !== false) {
          const scheduleContainer = document.getElementById('calendar-objects-list');
          if (scheduleContainer && !options.appendEvents) scheduleContainer.innerHTML = '';

          for (const item of placeEventItems) {
            if (item.fields.monthN == renderedMonth) {
              const eventDate = new Date(item.fields.exactDate);
              if (eventDate >= today) {
                new dateObjects(item.fields).createObject(item.fields);
                scheduleCount += 1;
              }
            }
          }

          const event_container = document.getElementById('event-objects-list');
          if (event_container && !options.appendEvents) event_container.innerHTML = '';
          let upcomingEvents = 0;

          placeEventItems.forEach(event => {
            const e = { ...event.fields, _pk: event.pk };
            const eventDate = new Date(e.exactDate);

            if (eventDate >= today && event_container) {
              const card = document.createElement('div');
              card.className = 'calendar-event-card';
              card.style.backgroundColor = '#667eea';
              if (e.backgroundURL && window.placeLazyBackground) {
                window.placeLazyBackground(card, e.backgroundURL);
              } else if (e.backgroundURL) {
                card.style.backgroundImage = `url('${e.backgroundURL}')`;
              }
              card.onclick = () => showEventModal(e);
              card.style.cursor = 'pointer';

              const overlay = document.createElement('div');
              overlay.className = 'card-overlay';
              card.appendChild(overlay);

              const content = document.createElement('div');
              content.className = 'card-content';
              content.innerHTML = `
                <h4>${e.scheduleTitle}</h4>
                <p>📅 ${e.exactDate}</p>
              `;
              card.appendChild(content);
              event_container.appendChild(card);
              upcomingEvents += 1;
            }
          });

          if (!upcomingEvents && !options.appendEvents && event_container) {
            event_container.innerHTML = '<div class="empty-state">No upcoming events yet.</div>';
          }

          if (data.eventPagination) {
            placePlanPagination.eventOffset = data.eventPagination.next_offset || 0;
            placePlanPagination.eventHasNext = !!data.eventPagination.has_next;
            placePlanPagination.eventLoading = false;
            window.placeSetLoadMoreButton('events-load-more', placePlanPagination.eventHasNext, false, loadMorePlaceEvents);
          }
        }

        const placeScheduleItems = data['placeSchedule'] || [];
        const formatTime12 = (value) => {
          const match = String(value || '').trim().match(/^(\d{1,2}):(\d{2})(?::\d{2})?$/);
          if (!match) return value || '';
          const hour = Number(match[1]);
          return `${hour % 12 || 12}:${match[2]} ${hour < 12 ? 'AM' : 'PM'}`;
        };

        if (options.renderSchedules !== false) {
          const allSchedContainer = document.querySelector("#calendar-allsched-list");
          if (allSchedContainer && !options.appendSchedules) allSchedContainer.innerHTML = '';

          if (placeScheduleItems.length > 0 && allSchedContainer) {
          placeScheduleItems.forEach(schedItem => {
            // Also add to calendar
            new dateObjects(schedItem.fields).createObject(schedItem.fields);            

            const sched = schedItem.fields;
            // Create schedule card
            const schedCard = document.createElement('div');
            schedCard.className = 'schedule-card';
            
            // Get current user ID from request.user.id (server-side)
            const currentUserID = `{{request.user.id|default:"null"}}`;
            // Check if current user is the poster
            const isPoster = currentUserID && String(sched.posterID) === String(currentUserID);
            const scheduleTitle = sched.scheduleTitle || 'Trip';
            const scheduleDate = `${sched.monthN ? new Date((sched.yearN || 2000), (sched.monthN - 1), 1).toLocaleString('en-US', { month: 'long' }) : ''} ${sched.dateN || ''} ${sched.yearN || ''}`.trim();
            const scheduleRole = sched.MakerOrLooker === 'Look'
              ? 'Looking for transportation'
              : (sched.MakerOrLooker === 'Make'
                ? 'Trip organizer'
                : (sched.MakerOrLooker || 'Trip organizer'));
            const scheduleDetailsId = `schedule-more-${schedItem.pk}`;
            const placeNameFallback = '{{ place.placename|escapejs }}';
            const meetupPlaceLabel = sched.meetPlace || 'TBA';
            const destinationLabel = sched.endPlace || placeNameFallback || 'TBA';
            const meetupTimeLabel = formatTime12(sched.meetTime);
            const displayTitle = scheduleTitle
              .replace(/\bschedule\b/gi, '')
              .replace(/\s+/g, ' ')
              .trim() || `${meetupPlaceLabel} to ${destinationLabel}`;
            const dateTimeLabel = scheduleDate && meetupTimeLabel
              ? `${scheduleDate} at ${meetupTimeLabel}`
              : (scheduleDate || meetupTimeLabel || 'Date and time TBA');
            const transportLabel = sched.scheduleTravelType || (sched.MakerOrLooker === 'Look' ? 'Looking for a ride' : 'Carpool');
            const summaryActionMarkup = isPoster ? `
              <button class="btn-view-joiners" type="button" data-schedule-action="joiners">View Joiners</button>
            ` : `
              <button class="btn-join" type="button" data-schedule-action="join">Join</button>
            `;
            const expandedActionMarkup = isPoster ? `
              <button class="btn-delete-schedule" type="button" data-schedule-action="delete">Delete</button>
            ` : '';
            
            schedCard.innerHTML = `
              <div class="schedule-card-title">${escapeHtml(displayTitle)}</div>

              <div class="schedule-summary">
                <div class="schedule-route schedule-when">
                  <span class="schedule-route-text">
                    <span>${escapeHtml(dateTimeLabel)}</span>
                    <span class="schedule-separator" aria-hidden="true">-</span>
                    <span>${escapeHtml(meetupPlaceLabel)}</span>
                    <span class="schedule-separator">to</span>
                    <span>${escapeHtml(destinationLabel)}</span>
                  </span>
                  <button class="schedule-more-toggle" type="button" data-schedule-toggle aria-expanded="false" aria-controls="${scheduleDetailsId}">Details</button>
                  ${summaryActionMarkup}
                </div>
              </div>

              <div class="schedule-more" id="${scheduleDetailsId}" hidden>
                <div class="schedule-detail-stack">
                  <div class="schedule-detail-block">
                    <span class="detail-label">Meetup place</span>
                    <span class="detail-value">${escapeHtml(meetupPlaceLabel)}</span>
                  </div>
                  <div class="schedule-detail-block">
                    <span class="detail-label">Destination</span>
                    <span class="detail-value">${escapeHtml(destinationLabel)}</span>
                  </div>
                  <div class="schedule-detail-block">
                    <span class="detail-label">Date and time</span>
                    <span class="detail-value">${escapeHtml(dateTimeLabel)}</span>
                  </div>
                  <div class="schedule-detail-block">
                    <span class="detail-label">Transportation</span>
                    <span class="detail-value">${escapeHtml(transportLabel)}</span>
                  </div>
                  ${sched.scheduleCost ? `
                  <div class="schedule-detail-block">
                    <span class="detail-label">Cost</span>
                    <span class="detail-value">${escapeHtml(sched.scheduleCost)}</span>
                  </div>
                  ` : ''}
                  <div class="schedule-detail-block">
                    <span class="detail-label">Hosted by</span>
                    <div class="poster-info">
                      ${sched.posterImageURL ? `<img src="${escapeHtml(sched.posterImageURL)}" alt="${escapeHtml(sched.posterName || 'Schedule poster')}" class="poster-avatar" width="48" height="48" loading="lazy" decoding="async">` : '<div class="poster-avatar-placeholder">👤</div>'}
                      <div class="poster-details">
                        <div class="poster-name">${escapeHtml(sched.posterName || 'Anonymous')} ${sched.posterVerified ? '✓' : ''}</div>
                        <span class="poster-role">${escapeHtml(scheduleRole)}</span>
                        ${sched.detailsContact ? `<div class="poster-contact">${escapeHtml(sched.detailsContact)}</div>` : ''}
                      </div>
                    </div>
                  </div>
                </div>

                ${sched.otherDetails ? `<div class="schedule-description">${escapeHtml(sched.otherDetails)}</div>` : ''}

                ${sched.reviewCount || expandedActionMarkup ? `<div class="schedule-expanded-actions">
                  ${sched.reviewCount ? `<span class="review-count">👁 ${escapeHtml(sched.reviewCount)} views</span>` : ''}
                  ${expandedActionMarkup}
                </div>` : ''}
              </div>
            `;

            const toggleButton = schedCard.querySelector('[data-schedule-toggle]');
            const moreDetails = schedCard.querySelector(`#${scheduleDetailsId}`);
            if (toggleButton && moreDetails) {
              const setScheduleExpanded = (expanded) => {
                schedCard.classList.toggle('is-expanded', expanded);
                moreDetails.hidden = !expanded;
                toggleButton.setAttribute('aria-expanded', String(expanded));
                toggleButton.textContent = expanded ? 'Hide' : 'Details';
              };

              toggleButton.addEventListener('click', () => {
                setScheduleExpanded(toggleButton.getAttribute('aria-expanded') !== 'true');
              });
            }

            schedCard.querySelectorAll('[data-schedule-action]').forEach((button) => {
              button.addEventListener('click', () => {
                const action = button.dataset.scheduleAction;
                if (action === 'join') {
                  joinSchedule(schedItem.pk, scheduleTitle);
                } else if (action === 'joiners') {
                  viewJoiners(schedItem.pk, scheduleTitle);
                } else if (action === 'delete') {
                  deleteSchedule(schedItem.pk, scheduleTitle, button);
                }
              });
            });
            
            allSchedContainer.appendChild(schedCard);
            

          });
          } else if (!options.appendSchedules && allSchedContainer) {
            allSchedContainer.innerHTML = '<div class="empty-state">No schedules available for this location.</div>';
          }

          if (data.schedulePagination) {
            placePlanPagination.scheduleOffset = data.schedulePagination.next_offset || 0;
            placePlanPagination.scheduleHasNext = !!data.schedulePagination.has_next;
            placePlanPagination.scheduleLoading = false;
            window.placeSetLoadMoreButton('schedules-load-more', placePlanPagination.scheduleHasNext, false, loadMorePlaceSchedules);
          }

          if (!scheduleCount) {
            // scheduleContainer.innerHTML = '<div class="empty-state">No upcoming highlights this month.</div>';
          }
        }
      })
      .then(() => {
        setTimeout(() => {
          // showObjectListDIv();
        }, 500);
      })
      .catch((error) => {
        placePlanPagination.eventLoading = false;
        placePlanPagination.scheduleLoading = false;
        window.placeSetLoadMoreButton('events-load-more', placePlanPagination.eventHasNext, false, loadMorePlaceEvents);
        window.placeSetLoadMoreButton('schedules-load-more', placePlanPagination.scheduleHasNext, false, loadMorePlaceSchedules);
        if (options.rethrowErrors) throw error;
      });
  }

  function el(id) {
    return document.getElementById(id);
  }

  function showEventModal(eventData) {
    const modal = document.getElementById('eventDetailsModal');
    document.getElementById('eventDetailsTitle').textContent = eventData.scheduleTitle || 'Event Details';
    document.getElementById('eventDate').textContent = eventData.exactDate || 'N/A';
    // Set the value of the hidden input to the innerHTML of #eventDate
    var eventDateElem = document.getElementById('eventDate');
    var eventDateInput = document.getElementById('siargaoEventDate');
    if (eventDateElem && eventDateInput) {
      eventDateInput.value = eventDateElem.innerHTML;
    }

    // Wire registration action to the selected event PK
    const regForm = document.getElementById('siargaoEventRegisterForm');
    if (regForm && regForm.dataset && regForm.dataset.actionTemplate && eventData && eventData._pk) {
      regForm.action = regForm.dataset.actionTemplate.replace('/0/', '/' + eventData._pk + '/');
    }
    const regStatus = document.getElementById('siargaoEventRegisterStatus');
    if (regStatus) regStatus.textContent = '';
    const regSubmit = document.getElementById('siargaoEventRegisterSubmit');
    if (regSubmit) {
      regSubmit.disabled = false;
      regSubmit.textContent = regSubmit.dataset.defaultLabel || 'Register';
    }
    
    // Generate new math challenge when modal opens
    generateMathChallenge();
    const mathAnswerField = document.getElementById('mathAnswer');
    if (mathAnswerField) mathAnswerField.value = '';

    const locationElement = document.getElementById('eventLocation');
    const locationLink = document.getElementById('eventLocationLink');
    if (eventData.schedulePlace && eventData.schedulePlace.includes('https://')) {
      locationElement.textContent = 'Find Directions';
      locationLink.href = 'https://' + eventData.schedulePlace.split('https://')[1];
    } else {
      locationElement.textContent = eventData.schedulePlace || 'N/A';
      locationLink.href = '';
    }
    // document.getElementById('eventHost').textContent = eventData.posterName || 'Anonymous';
    
    // Show Instagram if available
    const instagramContainer = document.getElementById('eventInstagramContainer');
    if (eventData.posterInstagram) {
      const instagramLink = document.getElementById('eventInstagram');
      instagramLink.href = `https://instagram.com/${eventData.posterInstagram.replace('@', '')}`;
      instagramLink.textContent = eventData.posterInstagram;
      instagramContainer.style.display = 'block';
    } else {
      instagramContainer.style.display = 'none';
    }
    
    // Show website if available
    const websiteContainer = document.getElementById('eventWebsiteContainer');
    if (eventData.scheduleWebsite) {
      document.getElementById('eventWebsite').href = eventData.scheduleWebsite;
      websiteContainer.style.display = 'block';
    } else {
      websiteContainer.style.display = 'none';
    }
    
    // Show description if available
    const descriptionContainer = document.getElementById('eventDescriptionContainer');
    if (eventData.description) {
      document.getElementById('eventDescription').textContent = eventData.description;
      descriptionContainer.style.display = 'block';
    } else {
      descriptionContainer.style.display = 'none';
    }
    
    // Show additional details if available
    const additionalDetailsContainer = document.getElementById('eventAdditionalDetailsContainer');
    if (eventData.additionalDetails) {
      document.getElementById('eventAdditionalDetails').textContent = eventData.additionalDetails;
      additionalDetailsContainer.style.display = 'block';
    } else {
      additionalDetailsContainer.style.display = 'none';
    }
    
    // Show other details if available
    const detailsText = document.getElementById('eventDetailsText');
    if (eventData.otherDetails) {
      detailsText.textContent = eventData.otherDetails;
      detailsText.style.display = 'block';
    } else {
      detailsText.style.display = 'none';
    }
    
    // Show thumbnail/background image if available
    const imageContainer = document.getElementById('eventImageContainer');
    const imageElement = document.getElementById('eventDetailsImage');
    if (eventData.thumbnailURL || eventData.backgroundURL) {
      imageElement.src = eventData.thumbnailURL || eventData.backgroundURL;
      imageContainer.style.display = 'block';
    } else {
      imageContainer.style.display = 'none';
    }
    
    modal.style.display = 'block';
  }

  function closeEventModal() {
    document.getElementById('eventDetailsModal').style.display = 'none';
  }

  function closeAddScheduleModal() {
    const modal = document.getElementById('addScheduleModal');
    const status = document.getElementById('addScheduleStatus');
    const form = document.getElementById('addScheduleForm');
    if (status) {
      status.textContent = '';
      status.style.color = 'var(--accent)';
    }
    if (form) form.reset();
    if (modal) modal.style.display = 'none';
  }

  // Close modal when clicking outside of it
  window.onclick = function(event) {
    const eventModal = document.getElementById('eventDetailsModal');
    if (event.target == eventModal) {
      closeEventModal();
    }
    const bulletinImageModal = document.getElementById('bulletinImageModal');
    if (event.target == bulletinImageModal) {
      closeBulletinImageModal();
    }
    const chatModal = document.getElementById('mobileChatModal');
    if (event.target == chatModal) {
      closeMobileChatModal();
    }
    const addScheduleModal = document.getElementById('addScheduleModal');
    if (event.target == addScheduleModal) {
      closeAddScheduleModal();
    }
  }

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      closeBulletinImageModal();
    }
  });

  function closeMobileChatModal() {
    document.getElementById('mobileChatModal').style.display = 'none';
  }

  document.addEventListener("DOMContentLoaded", function() {
    const putCalendarHeader = document.querySelector("#calendar-container")
    if (!putCalendarHeader) return;
    const navButtons = document.createElement("div");
    let currentCalendarMonth = parseInt(putCalendarHeader.dataset.month, 10);
    let currentCalendarYear = parseInt(putCalendarHeader.dataset.year, 10);

    function getAdjacentMonth(month, year, amount) {
      const date = new Date(year, month - 1 + amount, 1);
      return { month: date.getMonth() + 1, year: date.getFullYear() };
    }

    function buildCalendarPageUrl(month, year) {
      return `{% if place_slug %}/places/{{ place_slug }}/${year}/${month}/{% else %}/place/{{ placeid }}/${month}/${year}/{% endif %}`;
    }

    function buildCalendarJsonUrl(month, year) {
      return `/place/json/{{ placeid }}/${month}/${year}/`;
    }

    function renderCalendar(month, year) {
      const firstDay = new Date(year, month - 1, 1).getDay();
      const daysInMonth = new Date(year, month, 0).getDate();
      const weekdayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      const weekdayClasses = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
      let day = 1;
      let rows = '';

      while (day <= daysInMonth) {
        let cells = '';
        for (let weekday = 0; weekday < 7; weekday += 1) {
          if ((day === 1 && weekday < firstDay) || day > daysInMonth) {
            cells += '<td class="noday">&nbsp;</td>';
          } else {
            cells += `<td class="${weekdayClasses[weekday]}" data-day="${day}">${day}</td>`;
            day += 1;
          }
        }
        rows += `<tr>${cells}</tr>`;
      }

      const table = putCalendarHeader.querySelector('table');
      const calendarHtml = `
        <table class="month">
          <thead><tr>${weekdayNames.map((name, index) => `<th class="${weekdayClasses[index]}">${name}</th>`).join('')}</tr></thead>
          <tbody>${rows}</tbody>
        </table>
      `;
      if (table) table.outerHTML = calendarHtml;
      else putCalendarHeader.insertAdjacentHTML('beforeend', calendarHtml);
    }

    function resetCalendarObjects() {
      window.schedDatas = [];
      window.allobjectList = [];
      window.allDates = Array.from(putCalendarHeader.querySelectorAll('.wed,.mon,.tue,.thu,.fri,.sat,.sun'));
      const selectedDateList = document.getElementById('calendar-objects-list');
      if (selectedDateList) selectedDateList.innerHTML = '';
      placePlanPagination.eventOffset = 0;
      placePlanPagination.eventHasNext = false;
      placePlanPagination.eventLoading = false;
      placePlanPagination.scheduleOffset = 0;
      placePlanPagination.scheduleHasNext = false;
      placePlanPagination.scheduleLoading = false;
    }

    function updateCalendarNavigation() {
      const previous = getAdjacentMonth(currentCalendarMonth, currentCalendarYear, -1);
      const next = getAdjacentMonth(currentCalendarMonth, currentCalendarYear, 1);
      const previousLink = navButtons.querySelector('[data-calendar-direction="previous"]');
      const nextLink = navButtons.querySelector('[data-calendar-direction="next"]');
      if (previousLink) previousLink.href = buildCalendarPageUrl(previous.month, previous.year);
      if (nextLink) nextLink.href = buildCalendarPageUrl(next.month, next.year);
      const currentHeader = document.getElementById('month-year');
      if (currentHeader) {
        currentHeader.textContent = new Date(currentCalendarYear, currentCalendarMonth - 1, 1).toLocaleString('en-US', {
          month: 'long',
          year: 'numeric',
        });
      }
    }

    function setCalendarNavigationLoading(isLoading) {
      putCalendarHeader.setAttribute('aria-busy', isLoading ? 'true' : 'false');
      navButtons.querySelectorAll('[data-calendar-direction]').forEach((link) => {
        link.setAttribute('aria-disabled', isLoading ? 'true' : 'false');
      });
      navButtons.querySelectorAll('.nav-btn').forEach((button) => {
        button.disabled = isLoading;
      });
    }

    async function navigateCalendar(month, year, historyMode) {
      const pageUrl = buildCalendarPageUrl(month, year);
      const jsonUrl = buildCalendarJsonUrl(month, year);
      const params = new URLSearchParams({
        include_resorts: '0',
        track_view: '0',
        event_limit: String(window.placePageSize || 10),
        event_offset: '0',
        schedule_limit: String(window.placePageSize || 10),
        schedule_offset: '0',
      });

      setCalendarNavigationLoading(true);
      try {
        await getPlan(`${jsonUrl}?${params.toString()}`, {
          skipBlogs: true,
          rethrowErrors: true,
          beforeRender(data) {
            renderCalendar(parseInt(data.month, 10), parseInt(data.year, 10));
            resetCalendarObjects();
          },
        });
        currentCalendarMonth = month;
        currentCalendarYear = year;
        putCalendarHeader.dataset.month = String(month);
        putCalendarHeader.dataset.year = String(year);
        window.placePlanBaseUrl = `${jsonUrl}?include_resorts=0&track_view=0`;
        updateCalendarNavigation();
        if (historyMode === 'replace') {
          window.history.replaceState({ calendarMonth: month, calendarYear: year }, '', pageUrl);
        } else if (historyMode !== 'none') {
          window.history.pushState({ calendarMonth: month, calendarYear: year }, '', pageUrl);
        }
      } catch (error) {
        window.location.href = pageUrl;
      } finally {
        setCalendarNavigationLoading(false);
      }
    }

    const previous = getAdjacentMonth(currentCalendarMonth, currentCalendarYear, -1);
    const next = getAdjacentMonth(currentCalendarMonth, currentCalendarYear, 1);
    navButtons.innerHTML = `
      <div class="calendar-header">
        <div class="calendar-header-left">
          <h2 id="month-year">December 2025</h2>
          {% if user.is_authenticated %}
          <button class="add-schedule-btn" id="openAddScheduleBtn" type="button">+ Add Schedule</button>
          {% endif %}
        </div>
        <div class="nav-buttons">
          <a href="${buildCalendarPageUrl(previous.month, previous.year)}" data-calendar-direction="previous" aria-label="Previous month">
            <button class="nav-btn" type="button" aria-hidden="true" tabindex="-1">❮</button>
          </a>
          <a href="${buildCalendarPageUrl(next.month, next.year)}" data-calendar-direction="next" aria-label="Next month">
            <button class="nav-btn" type="button" aria-hidden="true" tabindex="-1">❯</button>
          </a>
        </div>
      </div>
    `
    const getElementInsertBeforeit = putCalendarHeader.firstChild
    putCalendarHeader.insertBefore(navButtons, getElementInsertBeforeit);
    const makeItHeader = document.querySelector("#calendar-container > table > tbody > tr:nth-child(1) > th")
    const currentHeader = document.querySelector("#month-year")
    if (makeItHeader && currentHeader) {
      currentHeader.innerHTML = makeItHeader.innerHTML
      makeItHeader.remove()
    }
    updateCalendarNavigation();
    window.history.replaceState({
      calendarMonth: currentCalendarMonth,
      calendarYear: currentCalendarYear,
    }, '');

    navButtons.addEventListener('click', function (event) {
      const link = event.target.closest('[data-calendar-direction]');
      if (!link) return;
      event.preventDefault();
      if (putCalendarHeader.getAttribute('aria-busy') === 'true') return;
      const amount = link.dataset.calendarDirection === 'previous' ? -1 : 1;
      const target = getAdjacentMonth(currentCalendarMonth, currentCalendarYear, amount);
      navigateCalendar(target.month, target.year, 'push');
    });

    window.addEventListener('popstate', function (event) {
      const state = event.state || {};
      if (!state.calendarMonth || !state.calendarYear) return;
      navigateCalendar(parseInt(state.calendarMonth, 10), parseInt(state.calendarYear, 10), 'none');
    });

    const createScheduleUrl = "{% url 'home:create_schedule_for_place' placeid %}";
    const addScheduleModal = document.getElementById('addScheduleModal');
    const addScheduleForm = document.getElementById('addScheduleForm');
    const addScheduleStatus = document.getElementById('addScheduleStatus');
    const addScheduleSubmit = document.getElementById('addScheduleSubmit');
    const openAddScheduleBtn = document.getElementById('openAddScheduleBtn');
    const cancelAddSchedule = document.getElementById('cancelAddSchedule');
    const addScheduleClose = document.getElementById('addScheduleClose');

    const dayInput = document.getElementById('dateN');
    const monthInput = document.getElementById('monthN');
    const yearInput = document.getElementById('yearN');
    const endPlaceInput = document.getElementById('endPlace');

    function prefillScheduleFields() {
      const now = new Date();
      if (dayInput) dayInput.value = now.getDate();
      if (monthInput) monthInput.value = now.getMonth() + 1;
      if (yearInput) yearInput.value = now.getFullYear();
      // if (endPlaceInput) endPlaceInput.value = now.getFullYear();
    }

    if (openAddScheduleBtn && addScheduleModal) {
      openAddScheduleBtn.addEventListener('click', () => {
        prefillScheduleFields(); 
        if (addScheduleStatus) addScheduleStatus.textContent = '';
        addScheduleModal.style.display = 'block';
      });
    }

    [cancelAddSchedule, addScheduleClose].forEach(btn => {
      if (btn) btn.addEventListener('click', closeAddScheduleModal);
    });

    if (addScheduleForm) {
      addScheduleForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (addScheduleStatus) {
          addScheduleStatus.style.color = 'var(--accent)';
          addScheduleStatus.textContent = 'Saving...';
        }
        if (addScheduleSubmit) {
          addScheduleSubmit.disabled = true;
          addScheduleSubmit.textContent = 'Saving...';
        }
        const payload = {
          scheduleTypeAndMode: addScheduleForm.scheduleTypeAndMode.value,
          dateN: addScheduleForm.dateN.value,
          monthN: addScheduleForm.monthN.value,
          yearN: addScheduleForm.yearN.value,
          meetPlace: addScheduleForm.meetPlace.value,
          endPlace: addScheduleForm.endPlace.value,
          meetTime: addScheduleForm.meetTime.value,
          detailsContact: (addScheduleForm.detailsContact ? addScheduleForm.detailsContact.value : ''),
          MakerOrLooker: (addScheduleForm.MakerOrLooker ? addScheduleForm.MakerOrLooker.value : 'Make'),
        };
        try {
          const response = await fetch(createScheduleUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRFToken': csrftoken,
            },
            body: JSON.stringify(payload),
          });
          const data = await response.json();
          if (!response.ok) {
            throw new Error(data.error || 'Failed to create schedule');
          }
          if (addScheduleStatus) {
            addScheduleStatus.textContent = data.message || 'Schedule created. Refreshing...';
          }

          // Reload the page to the month/year of the created schedule
          setTimeout(() => {
            const targetMonth = data.monthN || new Date().getMonth() + 1;
            const targetYear = data.yearN || new Date().getFullYear();
            window.location.href = `{% if place_slug %}/places/{{ place_slug }}/${targetYear}/${targetMonth}/{% else %}/place/{{ placeid }}/${targetMonth}/${targetYear}/{% endif %}`.replace('${targetMonth}', targetMonth).replace('${targetYear}', targetYear);
          }, 600);
        } catch (err) {
          if (addScheduleStatus) {
            addScheduleStatus.textContent = err.message || 'Failed to create schedule';
            addScheduleStatus.style.color = '#e53e3e';
          }
        } finally {
          if (addScheduleSubmit) {
            addScheduleSubmit.disabled = false;
            addScheduleSubmit.textContent = 'Create schedule';
          }
        }
      });
    }

    // Handle user authentication for anonymous users
    const currentPageUser = '{{request.user}}';
    if (currentPageUser === "AnonymousUser") {
      const storedUsername = localStorage.getItem('username');
      const storedPasscode = localStorage.getItem('userID');
      
      if (storedUsername && storedPasscode) {
        const registerStoredUser = () => {
          fetch('/userProfile/registerjson', {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRFToken": csrftoken
            },
            body: JSON.stringify({
              username: storedUsername,
              password: storedPasscode,
              passwordConfirmation: storedPasscode,
              email: 'na@gmail.com',
              placeID: `{{placeid}}`
            }),
          })
          .then(response => {
            if (!response.ok) {
              throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
          })
          .then(data => {
            if (data.error) {
              console.error("User registration error:", data.error);
            }
          })
          .catch(error => {
            console.error("Failed to register user:", error);
          });
        };
        if (window.placeIdle) window.placeIdle(registerStoredUser);
        else window.setTimeout(registerStoredUser, 150);
      }
    }

    window.placePlanBaseUrl = `{% url 'home:placeCalendarJSONMonth' placeid currentMonth currentYear %}?include_resorts=0`;
    getPlan(buildPlacePlanUrl({
      event_limit: String(window.placePageSize || 10),
      event_offset: '0',
      schedule_limit: String(window.placePageSize || 10),
      schedule_offset: '0',
    }));

    const closeMapBtn = el('closeMapBtn');
    if (closeMapBtn) closeMapBtn.addEventListener('click', () => {
      el('mapModal').classList.remove('show');
    });
    
    const modal = el('mapModal');
    if (modal) modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.remove('show');
    });
    
    const openBtn = el('openMapBtn');
    if (openBtn && modal) {
      openBtn.addEventListener('click', () => {
        modal.classList.add('show');
      });
    }

    // Mobile chat functionality
    const mobileChatBtn = document.getElementById('mobileChatBtn');
    const mobileChatModal = document.getElementById('mobileChatModal');
    const openMobileChat = () => {
      if (mobileChatModal) mobileChatModal.style.display = 'block';
      ensureDiscussionHistory();
    };
    if (mobileChatBtn) mobileChatBtn.addEventListener('click', openMobileChat);

    // Quick ask functionality
    const quickAskInput = document.getElementById('quick-ask-input');
    const quickAskSend = document.getElementById('quick-ask-send');

    const sendQuickAsk = () => {
      if (!quickAskInput || !quickAskSend) return;
      const message = quickAskInput.value.trim();
      if (message) {
        // Set the message in the modal's textarea
        document.getElementById('discuss-message').value = message;
        // Disable modal send button and show spinner
        const modalSendBtn = document.getElementById('modal-send-btn');
        const modalOriginalContent = modalSendBtn.innerHTML;
        modalSendBtn.disabled = true;
        modalSendBtn.innerHTML = '<div class="spinner"></div>';
        // Send the message
        discussionFetcher(`{{placeid}}`, 'POST', quickAskSend).then(() => {
          // Re-enable modal send button and restore content
          modalSendBtn.disabled = false;
          modalSendBtn.innerHTML = modalOriginalContent;
        }).catch(() => {
          // Re-enable on error
          modalSendBtn.disabled = false;
          modalSendBtn.innerHTML = modalOriginalContent;
        });
        // Clear the input
        quickAskInput.value = '';
        // Open the modal
        openMobileChat();
      }
    };

    if (quickAskInput) {
      quickAskInput.addEventListener('focus', ensureDiscussionHistory, { once: true });
      quickAskInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          sendQuickAsk();
        }
      });
    }
    if (quickAskSend) quickAskSend.addEventListener('click', sendQuickAsk);



    // Siargao event registration (AJAX)
    const regForm = document.getElementById('siargaoEventRegisterForm');
    const regStatus = document.getElementById('siargaoEventRegisterStatus');
    const regSubmit = document.getElementById('siargaoEventRegisterSubmit');

    if (regForm) {
      regForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (!regForm.action) {
          if (regStatus) regStatus.textContent = 'Please select an event first.';
          return;
        }

        // Check honeypot field (should be empty)
        const honeypot = document.getElementById('website_field');
        if (honeypot && honeypot.value !== '') {
          if (regStatus) regStatus.textContent = 'Spam detected.';
          return;
        }

        // Validate math challenge
        const mathAnswer = document.getElementById('mathAnswer');
        if (mathAnswer && parseInt(mathAnswer.value) !== mathCorrectAnswer) {
          if (regStatus) regStatus.textContent = 'Incorrect answer. Please try again.';
          mathAnswer.value = '';
          mathAnswer.focus();
          return;
        }

        const defaultLabel = (regSubmit && regSubmit.dataset && regSubmit.dataset.defaultLabel) ? regSubmit.dataset.defaultLabel : 'Register';

        if (regStatus) regStatus.textContent = 'Registering...';
        if (regSubmit) {
          regSubmit.disabled = true;
          regSubmit.textContent = 'Registering...';
        }

        try {
          const formData = new FormData(regForm);
          const response = await fetch(regForm.action, {
            method: 'POST',
            headers: {
              'X-CSRFToken': csrftoken,
            },
            body: formData,
            credentials: 'same-origin',
          });

          // The Django view currently redirects back with query params.
          // `fetch` follows redirects by default, so `response.url` should include those params.
          let message = '';
          try {
            const finalUrl = new URL(response.url, window.location.origin);
            const params = finalUrl.searchParams;
            if (params.get('ev_reg_success') === '1') {
              message = 'Registered! See you there.';
              regForm.reset();
            } else if (params.get('ev_reg_exists') === '1') {
              message = 'You were already registered — we updated your details.';
            } else if (params.get('ev_reg_error') === '1') {
              message = 'Please add your full name and email.';
            }
          } catch (err) {
            // Ignore URL parsing issues and fall back to generic message.
          }

          if (!message) {
            if (response.ok) {
              message = 'Registration submitted.';
            } else {
              message = 'Registration failed. Please try again.';
            }
          }

          if (regStatus) regStatus.textContent = message;
          
          // Reset math challenge
          generateMathChallenge();
          const mathAnswerField = document.getElementById('mathAnswer');
          if (mathAnswerField) mathAnswerField.value = '';
        } catch (err) {
          if (regStatus) regStatus.textContent = 'Network error. Please try again.';
        } finally {
          if (regSubmit) {
            regSubmit.disabled = false;
            regSubmit.textContent = defaultLabel;
          }
        }
      });
    }
  });
</script>

